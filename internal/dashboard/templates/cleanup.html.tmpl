{{define "cleanupnote"}}<div class="callout callout-attention cleanup-note" data-cleanup="{{if .Ask}}{{.Ask}}{{else}}warning{{end}}"><span class="callout-glyph" aria-hidden="true">&#9650;</span><div class="callout-body"><p class="callout-title">{{.Title}}</p><p class="callout-detail"><code class="mono">{{.Branch}}</code>{{if .PR}} &middot; {{if .URL}}<a href="{{.URL}}" target="_blank" rel="noopener">#{{.PR}}</a>{{else}}#{{.PR}}{{end}}{{end}}</p></div>{{if .Ask}}<div class="callout-actions"><button type="button" class="btn" data-live-op="clean" data-repo="{{.Repo}}" data-path="{{.Path}}" data-key="{{.Path}}/cleanup/clean">{{if eq .Ask "auto"}}Clean up now{{else}}Clean up{{end}}</button><button type="button" class="btn btn-ghost" data-live-op="keep" data-repo="{{.Repo}}" data-path="{{.Path}}" data-key="{{.Path}}/cleanup/keep">Keep</button></div>{{end}}</div>{{end}}
