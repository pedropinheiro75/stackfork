<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>stackfork dashboard</title>
<meta name="description" content="Every branch gets its own running stack.">
<link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
<script src="/static/theme-init.js"></script>
<link rel="stylesheet" href="/static/tokens.css">
<link rel="stylesheet" href="/static/app.css">
<meta name="stackfork-token" content="{{.Token}}">
</head>
<body>
<div class="app">
<nav class="rail" aria-label="Views">
  <span class="rail-mark" aria-hidden="true" title="stackfork: every branch gets its own running stack">s</span>
    <button type="button" class="rail-item" data-view="instances" aria-current="page" title="Instances">
      <svg class="rail-icon" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="2.5" width="12" height="4" rx="1"/><rect x="2" y="9.5" width="12" height="4" rx="1"/></svg><span class="sr-only">Instances</span><span class="rail-count" id="rail-count-instances">{{if .Loading}}&hellip;{{else}}{{.RunningCount}}/{{.Total}}{{end}}</span>
    </button>
    <button type="button" class="rail-item" data-view="repos" title="Repos">
      <svg class="rail-icon" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 4.5a1 1 0 0 1 1-1h3l1.5 1.5H13a1 1 0 0 1 1 1V12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/></svg><span class="sr-only">Repos</span><span class="rail-count" id="rail-count-repos"></span>
    </button>
    <button type="button" class="rail-item" data-view="cleanup" title="Clean up">
      <svg class="rail-icon" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 4.5h10M6.5 4.5V3h3v1.5M4.5 4.5l.5 8.5h6l.5-8.5"/></svg><span class="sr-only">Clean up</span><span class="rail-count" id="rail-count-cleanup"></span>
    </button>
    <button type="button" class="rail-item" data-view="settings" title="Settings">
      <svg class="rail-icon" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="2"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"/></svg><span class="sr-only">Settings</span><span class="rail-count" id="rail-count-settings"></span>
    </button>
</nav>
<div class="shell">
<header class="toolbar">
  <h1 id="view-title" class="toolbar-title">Instances</h1>
  <div class="toolbar-tools" data-for="instances">
    <input id="filter" type="text" placeholder="Filter instances" aria-label="Filter instances">
    <label><input id="running-only" type="checkbox"> Running only</label>
  </div>
  <div class="toolbar-tools" data-for="repos" hidden>
    <input id="repo-filter" type="text" placeholder="Search repos and branches" aria-label="Search repos and branches">
    <label><input id="ready-only" type="checkbox"> Ready only</label>
    <button type="button" id="rescan" class="btn btn-ghost" title="Walk the folders again and re-read every repo">Rescan</button>
    <span id="scan-state" class="muted"></span>
  </div>
  <div class="system-cluster">
    <span id="docker-status" class="chip status-pill {{if .Loading}}chip-busy{{else if .Docker.Reachable}}chip-ok{{else}}chip-failed{{end}}" data-state="{{if .Loading}}busy{{else if .Docker.Reachable}}ok{{else}}failed{{end}}"><span class="status-glyph" aria-hidden="true">{{if .Loading}}&#9684;{{else if .Docker.Reachable}}&#9679;{{else}}&#9650;{{end}}</span><span class="status-text">Docker &middot; {{if .Loading}}checking&hellip;{{else if .Docker.Reachable}}ok{{else}}unreachable{{end}}</span></span>
    <span id="proxy-status" class="chip status-pill {{if .Loading}}chip-busy{{else if .Proxy.Running}}chip-ok{{else}}chip-off{{end}}" data-state="{{if .Loading}}busy{{else if .Proxy.Running}}ok{{else}}off{{end}}"><span class="status-glyph" aria-hidden="true">{{if .Loading}}&#9684;{{else if .Proxy.Running}}&#9679;{{else}}&#9675;{{end}}</span><span class="status-text">Proxy &middot; {{if .Loading}}checking&hellip;{{else if .Proxy.Running}}:{{.Proxy.Port}}{{else}}stopped{{end}}</span></span>
    <button id="proxy-start" class="btn btn-ghost" data-action="proxy-up" title="Start the proxy for portless URLs"{{if or .Loading .Proxy.Running}} hidden{{end}}>Start proxy</button>
    <button id="theme-toggle" type="button" class="btn btn-ghost" data-theme-mode="system" aria-label="Theme: system. Switch to light">Theme: system</button>
    <span id="version" class="mono">{{.Version}}</span>
  </div>
</header>

<div class="banners">
  <div id="disk-banner" class="banner banner-attention" role="alert" hidden><span class="banner-glyph" aria-hidden="true">&#9650;</span><span class="banner-text"><span id="disk-text"></span>. Builds and installs fail with "no space left on device" when it fills up.</span> <button type="button" class="btn free-space-btn">Free Docker space</button></div>
  <div id="docker-banner" class="banner banner-failed" role="alert" hidden><span class="banner-glyph" aria-hidden="true">&#9650;</span><span class="banner-text">Docker is unreachable; showing the last known data.</span></div>
  <div id="proxy-banner" class="banner banner-busy" role="status"{{if not .Proxy.Hint}} hidden{{end}}><span class="banner-glyph" aria-hidden="true">&#9432;</span><span id="proxy-banner-text" class="banner-text">{{.Proxy.Hint}}</span><button type="button" id="proxy-banner-dismiss" class="btn btn-ghost" aria-label="Dismiss">Dismiss</button></div>
</div>

<main id="view-instances" class="view">
  <div id="instances-empty" class="empty-state"{{if or .Loading (ne .Total 0)}} hidden{{end}}>
    <h2>No instances yet</h2>
    <p class="muted">Start one from <a href="#repos">Repos &rarr; Start</a>, or run this in a project folder:</p>
    <p class="command-row"><span class="mono">stackfork prepare &amp;&amp; stackfork up</span> <button type="button" class="btn btn-ghost" data-copy="stackfork prepare &amp;&amp; stackfork up">Copy</button></p>
  </div>
  <p id="instances-none" class="muted" hidden>No instances match the filter.</p>
  <div id="projects" class="project-list">{{if .Loading}}<p class="muted" id="loading-note" role="status">loading...</p><div class="skeleton-card" aria-hidden="true"></div><div class="skeleton-card" aria-hidden="true"></div><div class="skeleton-card" aria-hidden="true"></div>{{end}}{{range .Projects}}{{template "project" .}}{{end}}</div>
</main>

<main id="view-repos" class="view" hidden>
  <div class="repo-viewbar">
    <fieldset class="segmented"><legend class="sr-only">Sort repos by</legend>
      <label><input type="radio" name="repo-sort" value="activity" checked><span>Activity</span></label>
      <label><input type="radio" name="repo-sort" value="name"><span>Name</span></label>
      <label><input type="radio" name="repo-sort" value="folder"><span>Folder</span></label>
    </fieldset>
    <label><input type="checkbox" id="repo-group"> Group by folder</label>
  </div>
  <div id="repos-list" aria-live="polite"></div>
</main>

<main id="view-cleanup" class="view" hidden>
  <h2 class="sr-only">Clean up</h2>
  <section class="card disk-card" aria-labelledby="disk-title">
    <div class="disk-head">
      <div class="disk-id"><h3 id="disk-title">Docker disk</h3><p class="muted">Images, containers, volumes and build cache.</p></div>
      <div class="disk-gauge"><div id="disk-meter" class="disk-bar" role="meter" aria-labelledby="disk-title" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-valuetext="not measured yet"><span class="disk-fill"></span></div><span id="cleanup-disk" class="mono disk-text">Measuring&hellip;</span></div>
      <button type="button" class="btn btn-primary free-space-btn">Free Docker space</button>
    </div>
    <p class="muted">Removes build cache, dangling images and anonymous volumes no container uses. Named volumes (your databases) are kept.</p>
  </section>
  <h3 class="micro section-title">Prune instances</h3>
  <p class="muted prune-note"><strong>Run</strong> first shows what would be removed in a confirmation dialog; nothing is deleted until you confirm. In a terminal, each is a dry run until you add <code>--yes</code>.</p>
  <table class="prune-table">
    <caption class="sr-only">Prune targets</caption>
    <thead><tr><th scope="col" class="micro">Target</th><th scope="col" class="micro num">Instances</th><th scope="col" class="micro">Command</th><th scope="col" class="micro"><span class="sr-only">Actions</span></th></tr></thead>
    <tbody id="cleanup-list"><tr><td colspan="4" class="muted">loading...</td></tr></tbody>
  </table>
</main>

<main id="view-settings" class="view" hidden>
  <div id="settings-body"></div>
  <p id="settings-error" class="form-error" role="alert"></p>
</main>
</div>
</div>

<div id="activity-log"></div>

<div id="toasts" class="toasts"><div id="toast-status" role="status" aria-live="polite"></div><div id="toast-alert" role="alert"></div></div>

<dialog id="learn-modal" aria-labelledby="learn-title">
  <div class="modal-head"><h2 id="learn-title">Set up with your agent</h2><button type="button" id="learn-close" class="btn btn-ghost btn-icon" aria-label="Close"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 4l8 8M12 4l-8 8"/></svg></button></div>
  <p class="muted modal-lede">Opens a new terminal window in the repo with your agent already running this prompt. It learns how the project starts, checks migrations, seed and login with you, and records it as verified.</p>
  <p class="micro modal-label" id="learn-agent-label">Agent</p>
  <div id="learn-agents" role="radiogroup" aria-labelledby="learn-agent-label"></div>
  <p class="micro modal-label">What the agent will check</p>
  <ul class="setup-steps"><li>Starts the stack</li><li>Runs migrations</li><li>Seeds data once</li><li>Signs in to the app</li></ul>
  <details class="learn-prompt-box">
    <summary class="micro">Prompt</summary>
    <pre id="learn-prompt" class="mono-log" tabindex="0"></pre>
    <button type="button" id="learn-copy" class="btn">Copy prompt</button>
  </details>
  <p id="learn-status" class="muted" role="status"></p>
  <div class="modal-foot"><button type="button" id="learn-cancel" class="btn btn-ghost">Cancel</button><button type="button" id="learn-start" class="btn btn-primary" disabled>Start setup</button></div>
</dialog>

<dialog id="secret-dialog" class="modal" aria-labelledby="sd-title">
  <form id="sd-form" autocomplete="off">
    <div class="modal-head"><h2 id="sd-title">Add secret</h2><button type="button" id="sd-close" class="btn btn-ghost btn-icon" aria-label="Close"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 4l8 8M12 4l-8 8"/></svg></button></div>
    <p class="muted modal-lede">Map a name to where its value lives. The value itself never goes through this page.</p>
    <div id="sd-fields">
      <div class="field"><label for="sd-name">Name</label><input type="text" id="sd-name" name="name" placeholder="NPM_TOKEN" spellcheck="false" autocapitalize="off" required></div>
      <div class="field"><label for="sd-ref">Reference</label><input type="text" id="sd-ref" name="reference" placeholder="keychain:acme-npm-token or op://Vault/Item/field" spellcheck="false" autocapitalize="off" aria-describedby="sd-ref-hint" required><p class="small muted" id="sd-ref-hint">A pointer to the value, not the value. Never paste a secret here.</p></div>
      <fieldset>
        <legend class="micro modal-label">Applies to</legend>
        <label class="scope-opt" id="sd-repo-opt"><input type="radio" name="scope" value="repo"><span id="sd-repo-label">This repository</span></label>
        <label class="scope-opt"><input type="radio" name="scope" value="folder"><span>A folder, and every repository under it</span></label>
        <div class="field" id="sd-folder-field"><label for="sd-folder" class="sr-only">Folder</label><input type="text" id="sd-folder" name="folder" placeholder="~/code/Client" spellcheck="false" autocapitalize="off"></div>
      </fieldset>
    </div>
    <p id="sd-error" class="form-error" role="alert"></p>
    <div id="sd-next" class="modal-note" hidden>
      <p id="sd-next-text" role="status"></p>
    </div>
    <div class="modal-foot"><button type="button" id="sd-cancel" class="btn btn-ghost">Cancel</button><button type="button" id="sd-set" class="btn" hidden>Set value&hellip;</button><button type="submit" id="sd-save" class="btn btn-primary">Save</button></div>
  </form>
</dialog>

<dialog id="unmap-dialog" class="modal" aria-labelledby="ud-title">
  <div class="modal-head"><h2 id="ud-title">Unmap secret</h2></div>
  <p class="muted modal-lede" id="ud-text"></p>
  <div class="modal-foot"><button type="button" id="ud-cancel" class="btn btn-ghost">Cancel</button><button type="button" id="ud-confirm" class="btn btn-danger">Unmap</button></div>
</dialog>

<aside id="logs-panel" class="log-drawer" role="dialog" aria-modal="false" aria-labelledby="logs-title" tabindex="-1" hidden>
  <div id="logs-header">
    <h2 id="logs-title" class="mono"></h2>
    <button id="logs-close" type="button" class="btn btn-ghost btn-icon" aria-label="Close logs" title="Close (Escape)"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 4l8 8M12 4l-8 8"/></svg></button>
  </div>
  <div id="logs-run" hidden>
    <div id="logs-steps" role="group" aria-label="Steps of this run"></div>
    <label id="logs-follow-label"><input type="checkbox" id="logs-follow" checked> Follow</label>
  </div>
  <div id="logs-gate" class="callout callout-attention" hidden>
    <span class="callout-glyph" aria-hidden="true">&#9650;</span>
    <div class="callout-body"><p class="callout-title">Logs stay hidden until stackfork can mask your secrets in them.</p><p class="callout-detail">Checking reads each secret once; 1Password may ask you to unlock it. Values are never shown.</p><p class="callout-detail" id="logs-gate-note" role="status"></p></div>
    <div class="callout-actions"><button type="button" class="btn" id="logs-gate-check" data-key="logs/gate/check">Check secrets to view logs</button></div>
  </div>
  <pre id="logs-body" class="mono-log" tabindex="0" aria-label="Log output"></pre>
</aside>

<script src="/static/app.js"></script>
</body>
</html>
