<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>stackfork dashboard</title>
<link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
<script src="/static/theme-init.js"></script>
<link rel="stylesheet" href="/static/tokens.css">
<link rel="stylesheet" href="/static/app.css">
<meta name="stackfork-token" content="{{.Token}}">
</head>
<body>
<div class="app">
<nav class="rail" aria-label="Views">
  <span class="rail-mark" aria-hidden="true">s</span>
    <button type="button" class="rail-item" data-view="instances" aria-current="page" title="Instances">
      <svg class="rail-icon" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="2.5" width="12" height="4" rx="1"/><rect x="2" y="9.5" width="12" height="4" rx="1"/></svg><span class="sr-only">Instances</span><span class="rail-count" id="rail-count-instances">{{if .Loading}}&hellip;{{else}}{{.RunningCount}}/{{.Total}}{{end}}</span>
    </button>
    <button type="button" class="rail-item" data-view="repos" title="Repos">
      <svg class="rail-icon" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 4.5a1 1 0 0 1 1-1h3l1.5 1.5H13a1 1 0 0 1 1 1V12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/></svg><span class="sr-only">Repos</span><span class="rail-count" id="rail-count-repos"></span>
    </button>
    <button type="button" class="rail-item" data-view="cleanup" title="Clean up">
      <svg class="rail-icon" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 4.5h10M6.5 4.5V3h3v1.5M4.5 4.5l.5 8.5h6l.5-8.5"/></svg><span class="sr-only">Clean up</span><span class="rail-count" id="rail-count-cleanup"></span>
    </button>
    <button type="button" class="rail-item" data-view="settings" title="Settings">
      <svg class="rail-icon" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="2"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"/></svg><span class="sr-only">Settings</span><span class="rail-count" id="rail-count-settings"></span>
    </button>
</nav>
<div class="shell">
<header class="toolbar">
  <h1 id="view-title" class="toolbar-title">Instances</h1>
  <div class="toolbar-tools" data-for="instances">
    <input id="filter" type="text" placeholder="Filter instances" aria-label="Filter instances">
    <label><input id="running-only" type="checkbox"> Running only</label>
  </div>
  <div class="toolbar-tools" data-for="repos" hidden>
    <input id="repo-filter" type="text" placeholder="Search repos and branches" aria-label="Search repos and branches">
    <label><input id="ready-only" type="checkbox"> Ready only</label>
    <button type="button" id="rescan" class="btn btn-ghost" title="Walk the folders again and re-read every repo">Rescan</button>
    <span id="scan-state" class="muted"></span>
  </div>
  <div class="system-cluster">
    <span id="docker-status" class="chip status-pill {{if .Loading}}chip-busy{{else if .Docker.Reachable}}chip-ok{{else}}chip-failed{{end}}" data-state="{{if .Loading}}busy{{else if .Docker.Reachable}}ok{{else}}failed{{end}}"><span class="status-glyph" aria-hidden="true">{{if .Loading}}&#9684;{{else if .Docker.Reachable}}&#9679;{{else}}&#9650;{{end}}</span><span class="status-text">Docker &middot; {{if .Loading}}checking&hellip;{{else if .Docker.Reachable}}ok{{else}}unreachable{{end}}</span></span>
    <span id="proxy-status" class="chip status-pill {{if .Loading}}chip-busy{{else if .Proxy.Running}}chip-ok{{else}}chip-off{{end}}" data-state="{{if .Loading}}busy{{else if .Proxy.Running}}ok{{else}}off{{end}}"><span class="status-glyph" aria-hidden="true">{{if .Loading}}&#9684;{{else if .Proxy.Running}}&#9679;{{else}}&#9675;{{end}}</span><span class="status-text">Proxy &middot; {{if .Loading}}checking&hellip;{{else if .Proxy.Running}}:{{.Proxy.Port}}{{else}}stopped{{end}}</span></span>
    <button id="proxy-start" class="btn btn-ghost" data-action="proxy-up" title="Start the proxy for portless URLs"{{if or .Loading .Proxy.Running}} hidden{{end}}>Start proxy</button>
    <button id="theme-toggle" type="button" class="btn btn-ghost" data-theme-mode="system" aria-label="Theme: system. Switch to light">Theme: system</button>
    <span id="version" class="mono">{{.Version}}</span>
  </div>
</header>

<div class="banners">
  <div id="disk-banner" class="banner banner-attention" role="alert" hidden><span class="banner-glyph" aria-hidden="true">&#9650;</span><span class="banner-text"><span id="disk-text"></span>. Builds and installs fail with "no space left on device" when it fills up.</span> <button type="button" class="btn free-space-btn">Free Docker space</button></div>
  <div id="docker-banner" class="banner banner-failed" role="alert" hidden><span class="banner-glyph" aria-hidden="true">&#9650;</span><span class="banner-text">Docker is unreachable; showing the last known data.</span></div>
  <div id="proxy-banner" class="banner banner-busy" role="status"{{if not .Proxy.Hint}} hidden{{end}}><span class="banner-glyph" aria-hidden="true">&#9432;</span><span id="proxy-banner-text" class="banner-text">{{.Proxy.Hint}}</span><button type="button" id="proxy-banner-dismiss" class="btn btn-ghost" aria-label="Dismiss">Dismiss</button></div>
</div>

<main id="view-instances" class="view">
  <div id="instances-empty" class="empty-state"{{if or .Loading (ne .Total 0)}} hidden{{end}}>
    <h2>No instances yet</h2>
    <p class="muted">Start one from <a href="#repos">Repos &rarr; Start</a>, or run this in a project folder:</p>
    <p class="command-row"><span class="mono">stackfork prepare &amp;&amp; stackfork up</span> <button type="button" class="btn btn-ghost" data-copy="stackfork prepare &amp;&amp; stackfork up">Copy</button></p>
  </div>
  <section class="section" data-section="running">
    <h2 class="section-title micro">Running <span class="section-count">{{len .Running}}</span></h2>
    <div class="stack-list">
      {{if .Loading}}<p class="muted" id="loading-note" role="status">loading...</p>
      <div class="skeleton-card" aria-hidden="true"></div><div class="skeleton-card" aria-hidden="true"></div><div class="skeleton-card" aria-hidden="true"></div>{{end}}
      {{range .Running}}{{template "stack" .}}{{end}}
    </div>
  </section>
  <section class="section" data-section="stopped">
    <h2 class="section-title micro">Stopped <span class="section-count">{{len .Stopped}}</span></h2>
    <div class="stack-list">
      {{range .Stopped}}{{template "stack" .}}{{end}}
    </div>
  </section>
</main>

<main id="view-repos" class="view" hidden>
  <div id="repos-list" aria-live="polite"></div>
</main>

<main id="view-cleanup" class="view view-narrow" hidden>
  <h2>Clean up</h2>
  <p><button type="button" class="btn free-space-btn">Free Docker space</button> <span id="cleanup-disk" class="muted"></span><br>
  <span class="muted">Removes build cache, dangling images and anonymous volumes no container uses. Named volumes (your databases) are kept.</span></p>
  <p>Instances: <strong>Run</strong> first shows what would be removed in a confirmation dialog; nothing is deleted until you confirm. In a terminal, each is a dry run until you add <code>--yes</code>.</p>
  <ul id="cleanup-list"><li>loading...</li></ul>
</main>

<main id="view-settings" class="view view-narrow" hidden>
  <div id="settings-body"></div>
  <p id="settings-error" class="form-error" role="alert"></p>
</main>
</div>
</div>

<div id="activity-log"></div>

<dialog id="learn-modal" aria-labelledby="learn-title">
  <h2 id="learn-title">Learn</h2>
  <p class="muted">Opens a new terminal window in the repo with your agent already running this prompt. It learns how the project starts, checks migrations, seed and login with you, and records it as verified.</p>
  <div id="learn-agents"></div>
  <p id="learn-status" role="status"></p>
  <details>
    <summary>Prompt</summary>
    <pre id="learn-prompt"></pre>
    <button type="button" id="learn-copy" class="repo-btn">Copy prompt</button>
  </details>
  <form method="dialog"><button class="repo-btn">Close</button></form>
</dialog>

<div id="logs-panel" hidden>
  <div id="logs-header">
    <span id="logs-title"></span>
    <button id="logs-close" type="button" class="icon-btn" title="Close">&#10005;</button>
  </div>
  <pre id="logs-body"></pre>
</div>

<script src="/static/app.js"></script>
</body>
</html>

{{define "chip"}}<span class="chip chip-{{.Class}}"{{if .Title}} title="{{.Title}}"{{end}}><span class="chip-glyph" aria-hidden="true">{{.Glyph}}</span>{{.Label}}</span>{{end}}

{{define "stack"}}
{{$inst := .}}{{$p := .Project}}{{$name := displayName .Project}}{{$live := isLive .State}}{{$app := openApp .Apps}}
<article class="stack lane-{{lane .ColorIndex}}" data-project="{{.Project}}" data-state="{{.State}}" data-collapsed="{{if $live}}0{{else}}1{{end}}">
<header class="stack-header">
<button type="button" class="btn btn-ghost btn-icon chevron" data-toggle-stack data-project="{{.Project}}" data-key="{{.Project}}/toggle" aria-expanded="{{if $live}}true{{else}}false{{end}}" aria-label="Details for {{$name}}"><span class="chevron-glyph" aria-hidden="true"></span></button>
<span class="avatar" aria-hidden="true">{{initial .Project}}</span>
<div class="stack-id">
<h3 class="stack-name" title="{{.Project}}">{{$name}}</h3>
<span class="branch-pill" title="{{.Branch}}">&#8997; {{.Branch}}</span>
{{template "chip" stateChip .State}}{{if .Legacy}}<span class="chip chip-off">legacy</span>{{end}}{{if .Knowledge}}<span class="chip chip-{{knowledgeTone .Knowledge.Status}}" title="Setup knowledge">{{.Knowledge.Status}}</span>{{end}}
<div class="stack-actions">
{{if not $live}}<button type="button" class="btn" data-action="up" data-project="{{.Project}}" data-key="{{.Project}}/up">Start</button>{{end}}
{{if and $live $app}}<a class="btn mobile-hide" href="{{$app.URL}}" target="_blank" rel="noopener" data-key="{{.Project}}/open" title="{{$app.URL}}">Open App</a>{{end}}
{{if $live}}<button type="button" class="btn btn-ghost mobile-hide" data-action="down" data-project="{{.Project}}" data-key="{{.Project}}/down" title="Stop (keeps volumes)">Stop</button>{{end}}
<div class="menu-anchor"><button type="button" class="btn btn-ghost btn-icon" data-key="{{.Project}}/menu" aria-haspopup="menu" aria-expanded="false" aria-label="More actions for {{$name}}" title="More actions"><span aria-hidden="true">&#8943;</span></button><div class="menu" role="menu" hidden>
{{if eq .State "partial"}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/menu/up" data-action="up" data-project="{{.Project}}"><span class="menu-label">Start stopped services</span></button>{{end}}
{{if $live}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/menu/restart" data-action="restart" data-project="{{.Project}}"><span class="menu-label">Restart</span></button>
<button type="button" role="menuitem" class="menu-item mobile-only" tabindex="-1" data-key="{{.Project}}/menu/down" data-action="down" data-project="{{.Project}}"><span class="menu-label">Stop</span></button>{{end}}
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/menu/path" data-copy="{{.Root}}"><span class="menu-label">Copy path</span></button>
{{if .EnvBlock}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/menu/env" data-copy="{{.EnvBlock}}" data-copy-kind="env_block" data-copy-project="{{.Project}}"><span class="menu-label">Copy .env for host app</span></button>{{end}}
{{range $i, $c := warningCommands .Commands}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$p}}/menu/cmd{{$i}}" {{if runnable $c}}data-run{{else}}data-copy{{end}}="{{$c}}"><span class="menu-label">{{if runnable $c}}Run command{{else}}Copy command{{end}}</span><span class="menu-cmd mono">{{$c}}</span></button>{{end}}
{{$down := index .Commands 0}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/menu/copydown" data-copy="{{$down}}"><span class="menu-label">Copy down command</span><span class="menu-cmd mono">{{$down}}</span></button>
<hr class="menu-sep" role="separator">
<button type="button" role="menuitem" class="menu-item menu-item-danger" tabindex="-1" data-key="{{.Project}}/menu/remove" data-run="{{$down}}"><span class="menu-label">Remove instance and data</span><span class="menu-cmd mono">{{$down}}</span></button>
</div></div>
</div>
<div class="stack-meta mono"><span class="stack-path" title="{{.Root}}">{{or .RelRoot .Root}}</span>{{if .Hostname}}<span class="stack-sep" aria-hidden="true"> &middot; </span><span class="stack-host" title="{{.Hostname}}">{{.Hostname}}</span>{{end}}</div>
</div>
</header>
{{if .Apps}}<div class="app-strip">{{range $i, $a := .Apps}}{{if and .URL .Running}}<a class="app-chip" data-key="{{$p}}/app{{$i}}" href="{{.URL}}" target="_blank" rel="noopener" title="{{.URL}}{{if .Direct}} (direct: {{.Direct}}){{end}}">{{.Label}}</a>{{else if .URL}}<span class="app-chip stopped" title="Starts with the stack">{{.Label}}</span>{{else}}<span class="app-chip stopped" title="Starts with the stack">{{.Label}}{{if .Hint}}: {{.Hint}}{{end}}</span>{{end}}{{end}}</div>{{end}}
{{if .SeedCommand}}<div class="callout callout-failed" data-seed="failed"><span class="callout-glyph" aria-hidden="true">&#8856;</span><div class="callout-body"><p class="callout-title">Database seed failed</p><p class="callout-detail">Retry runs it again. If the app already has its data, mark it as seeded instead.</p>{{if .SeedError}}<pre class="mono-log" tabindex="0" data-key="{{.Project}}/seed/log" aria-label="Seed output">{{.SeedError}}</pre>{{end}}</div><div class="callout-actions"><button type="button" class="btn" data-run="{{.SeedCommand}}" data-key="{{.Project}}/seed/retry" title="{{.SeedCommand}}">Retry seed</button><div class="menu-anchor"><button type="button" class="btn btn-ghost btn-icon" data-key="{{.Project}}/seed/menu" aria-haspopup="menu" aria-expanded="false" aria-label="More seed actions for {{$name}}" title="More seed actions"><span aria-hidden="true">&#8943;</span></button><div class="menu" role="menu" hidden>
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/seed/done" data-run="{{.SeedDone}}"><span class="menu-label">Mark as seeded</span><span class="menu-cmd mono">{{.SeedDone}}</span></button>
<hr class="menu-sep" role="separator">
<button type="button" role="menuitem" class="menu-item menu-item-danger" tabindex="-1" data-key="{{.Project}}/seed/force" data-run="{{.SeedForce}}"><span class="menu-label">Re-seed, overwriting data</span><span class="menu-cmd mono">{{.SeedForce}}</span></button>
</div></div></div></div>{{end}}
{{if .Warnings}}<div class="callout callout-attention" data-callout="warnings"><span class="callout-glyph" aria-hidden="true">&#9650;</span><div class="callout-body"><ul class="warnings">{{range .Warnings}}<li class="warning">{{.}}</li>{{end}}</ul></div></div>{{end}}
{{if or .OneOffRunning .OneOffLeftover}}<div class="callout callout-attention" data-oneoff="1"><span class="callout-glyph" aria-hidden="true">&#9650;</span><div class="callout-body">{{if .OneOffRunning}}<p class="callout-detail">{{plural .OneOffRunning "one-off task"}} running</p>{{end}}{{if .OneOffLeftover}}<p class="callout-detail">{{plural .OneOffLeftover "leftover one-off container"}}{{if .OneOffCleanup}} <span class="mono">{{.OneOffCleanup}}</span>{{end}}</p>{{end}}</div>{{if and .OneOffLeftover .OneOffCleanup}}<div class="callout-actions"><button type="button" class="btn" data-run="{{.OneOffCleanup}}" data-key="{{.Project}}/oneoff/clean" title="{{.OneOffCleanup}}">Clean up</button></div>{{end}}</div>{{end}}
<div class="stack-body">
{{if .Services}}<table class="service-table"><caption class="sr-only">Services of {{$name}}</caption><colgroup><col class="col-service"><col class="col-state"><col class="col-endpoints"><col class="col-actions"></colgroup><thead><tr><th scope="col" class="micro">Service</th><th scope="col" class="micro">State</th><th scope="col" class="micro">Endpoints</th><th scope="col" class="micro">Actions</th></tr></thead>
{{range .Services}}{{$svc := .}}<tbody class="service-group">
<tr class="service-row" data-service="{{.Name}}">
<td class="cell-service"><span class="service-logo" data-kind="{{.Kind}}"></span><div class="service-text"><button type="button" class="service-name" data-toggle-settings data-key="{{$p}}/{{.Name}}/settings" aria-expanded="false">{{.Name}}</button>{{if eq .State "optional"}}<span class="service-image mono">not started (optional)</span>{{else if .Image}}<span class="service-image mono" title="{{.Image}}">{{.Image}}</span>{{end}}</div></td>
<td class="cell-state">{{template "chip" serviceChip .}}</td>
<td class="cell-endpoints">{{if or .Endpoints .ConnectionURL .UseCommands}}<div class="endpoints">
{{range $i, $e := .Endpoints}}{{if .Known}}{{if or (eq .Scheme "http") (eq .Scheme "https")}}<a class="endpoint-link{{if ne $svc.State "running"}} stopped{{end}}" data-key="{{$p}}/{{$svc.Name}}/ep{{$i}}" href="{{.URL}}" target="_blank" rel="noopener" title="{{.URL}}"><span class="endpoint-url">{{.URL}}</span>{{$note := endpointNote $svc.State .Proxied}}{{if $note}}<span class="endpoint-note">{{$note}}</span>{{end}}</a>{{else}}<button type="button" class="endpoint-copy copyable{{if ne $svc.State "running"}} stopped{{end}}" data-key="{{$p}}/{{$svc.Name}}/ep{{$i}}" data-copy="{{.URL}}" title="click to copy">{{.URL}}{{$note := endpointNote $svc.State false}}{{if $note}} {{$note}}{{end}}</button>{{end}}{{else}}<span class="endpoint-pending" title="container port {{.Container}}">port assigned on start</span>{{end}}{{end}}
{{if .ConnectionURL}}<button type="button" class="endpoint-copy copyable connection-url" data-key="{{$p}}/{{$svc.Name}}/conn" data-copy="{{.ConnectionURL}}" data-copy-kind="database_url" data-copy-project="{{$p}}" data-copy-service="{{$svc.Name}}" title="click to copy the connection URL ({{.ConnectionURL}})">connection URL</button>{{end}}
{{range $i, $u := .UseCommands}}<button type="button" class="endpoint-copy copyable use-command" data-key="{{$p}}/{{$svc.Name}}/use{{$i}}" data-copy="{{.Value}}" data-copy-kind="cli" data-copy-project="{{$p}}" data-copy-service="{{$svc.Name}}" title="click to copy: {{.Value}}">{{.Label}}</button>{{end}}
</div>{{else}}<span class="endpoint-none">&mdash;</span>{{end}}</td>
<td class="cell-actions"><div class="row-actions"><button type="button" class="btn btn-ghost logs-button mobile-hide" data-project="{{$p}}" data-service="{{.Name}}" data-key="{{$p}}/{{.Name}}/logs">Logs</button><div class="menu-anchor"><button type="button" class="btn btn-ghost btn-icon" data-key="{{$p}}/{{.Name}}/menu" aria-haspopup="menu" aria-expanded="false" aria-label="More actions for {{.Name}}" title="More actions"><span aria-hidden="true">&#8943;</span></button><div class="menu" role="menu" hidden>
{{if eq .State "running"}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$p}}/{{.Name}}/menu/stop" data-action="service-stop" data-project="{{$p}}" data-service="{{.Name}}"><span class="menu-label">Stop</span></button>{{else}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$p}}/{{.Name}}/menu/start" data-action="service-start" data-project="{{$p}}" data-service="{{.Name}}"><span class="menu-label">Start</span></button>{{end}}
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$p}}/{{.Name}}/menu/restart" data-action="restart" data-project="{{$p}}" data-service="{{.Name}}"><span class="menu-label">Restart</span></button>
<button type="button" role="menuitem" class="menu-item logs-button mobile-only" tabindex="-1" data-key="{{$p}}/{{.Name}}/menu/logs" data-project="{{$p}}" data-service="{{.Name}}"><span class="menu-label">Logs</span></button>
</div></div></div></td>
</tr>
<tr class="service-settings" hidden><td colspan="4">
{{if .Ports}}<div class="setting-row"><span class="setting-label">Ports</span><span class="setting-values">{{range .Ports}}<span class="setting-value">{{.Container}}{{if .Host}} &rarr; {{.Host}}{{end}}/{{.Protocol}}</span>{{end}}</span></div>{{end}}
{{if .Volumes}}<div class="setting-row"><span class="setting-label">Volumes</span><span class="setting-values">{{range .Volumes}}<span class="setting-value">{{.Name}} &rarr; {{.Path}}{{if .ReadOnly}} (ro){{end}}</span>{{end}}</span></div>{{end}}
{{if .Healthcheck}}<div class="setting-row"><span class="setting-label">Healthcheck</span><code class="setting-value">{{.Healthcheck}}</code></div>{{end}}
{{if .DependsOn}}<div class="setting-row"><span class="setting-label">Depends on</span><span class="setting-values">{{range .DependsOn}}<span class="setting-value">{{.}}</span>{{end}}</span></div>{{end}}
{{if .Replicas}}<div class="setting-row"><span class="setting-label">Replicas</span><span class="setting-value">{{.Replicas}}</span></div>{{end}}
{{if .EnvKeys}}<div class="setting-row"><span class="setting-label">Environment</span><span class="setting-values">{{range .EnvKeys}}<span class="setting-value">{{.}}</span>{{end}}</span></div>{{end}}
{{if $inst.Files}}<div class="setting-row"><span class="setting-label">Source files</span><span class="setting-values">{{range $inst.Files}}<span class="setting-value">{{.}}</span>{{end}}</span></div>{{end}}
</td></tr>
</tbody>{{end}}
</table>{{end}}
</div>
</article>
{{end}}
