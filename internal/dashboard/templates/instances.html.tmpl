{{define "chip"}}<span class="chip chip-{{.Class}}"{{if .Title}} title="{{.Title}}"{{end}}><span class="chip-glyph" aria-hidden="true">{{.Glyph}}</span>{{.Label}}</span>{{end}}

{{define "project"}}
{{$app := .App}}{{$id := domID .App}}
<section class="project lane-{{lane .ColorIndex}}" id="proj-{{$id}}" data-app="{{$app}}" data-collapsed="0" aria-labelledby="proj-{{$id}}-h">
<header class="project-header">
<button type="button" class="btn btn-ghost btn-icon chevron" data-toggle-project data-app="{{$app}}" data-key="{{$app}}/toggle" aria-expanded="true" aria-controls="proj-{{$id}}-body" aria-label="Versions of {{$app}}"><span class="chevron-glyph" aria-hidden="true"></span></button>
<span class="avatar" aria-hidden="true">{{initial $app}}</span>
<div class="project-id">
<h2 class="project-name" id="proj-{{$id}}-h">{{$app}}</h2>
<span class="project-count">{{plural (len .Versions) "version"}}</span>
</div>
<div class="project-chips">{{range .Chips}}{{template "chip" .}}{{end}}</div>
<div class="menu-anchor"><button type="button" class="btn btn-ghost btn-icon" data-key="{{$app}}/menu" aria-haspopup="menu" aria-expanded="false" aria-label="More actions for {{$app}}" title="More actions"><span aria-hidden="true">&#8943;</span></button><div class="menu" role="menu" hidden>
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$app}}/menu/start" data-project-action="start" data-repo="{{.Root}}"><span class="menu-label">Start a branch&hellip;</span></button>
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$app}}/menu/repos" data-project-action="repos" data-repo="{{.Root}}"><span class="menu-label">Show in Repos</span></button>
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$app}}/menu/path" data-copy="{{.Root}}"><span class="menu-label">Copy repo path</span></button>
</div></div>
</header>
<div class="project-pills">{{range .Versions}}<span class="branch-pill" title="{{.Branch}}">{{.Branch}}</span>{{end}}</div>
<div class="project-body" id="proj-{{$id}}-body">{{range .Versions}}{{template "version" .}}{{end}}</div>
</section>
{{end}}

{{define "version"}}
{{$inst := .}}{{$p := .Project}}{{$appName := appName .Instance}}{{$name := print $appName " " .Branch}}{{$live := isLive .State}}{{$app := openApp .Apps .EntryNone}}{{$hint := hostHint .Apps}}
<article class="stack version lane-{{lane .ColorIndex}}" id="ver-{{domID .Project}}" data-project="{{.Project}}" data-state="{{.State}}" data-collapsed="{{if $live}}0{{else}}1{{end}}">
<header class="stack-header">
<button type="button" class="btn btn-ghost btn-icon chevron" data-toggle-stack data-project="{{.Project}}" data-key="{{.Project}}/toggle" aria-expanded="{{if $live}}true{{else}}false{{end}}" aria-controls="body-{{domID .Project}}" aria-label="Details for {{$name}}"><span class="chevron-glyph" aria-hidden="true"></span></button>
<div class="stack-id">
<h3 class="version-title" title="{{.Project}}"><span class="branch-pill" title="{{.Branch}}">{{.Branch}}</span></h3>
<div class="stack-chips">{{with .RunStarting}}{{template "chip" .}}{{else}}{{template "chip" stateChip $inst.State}}{{end}}{{if .Legacy}}<span class="chip chip-off">legacy</span>{{end}}{{if .Knowledge}}{{if or (eq .Knowledge.Status "draft") (eq .Knowledge.Status "stale")}}<span class="chip chip-attention" title="Setup knowledge: {{.Knowledge.Status}}"><span class="chip-glyph" aria-hidden="true">&#9650;</span>Setup unverified</span>{{end}}{{end}}{{if .EnvOverrides}}<span class="chip chip-attention env-chip" title="Env overrides replace the project's values until you reset them"><span class="chip-glyph" aria-hidden="true">&#9650;</span>{{plural .EnvOverrides "env override"}}</span><button type="button" class="btn btn-ghost" data-env-reset data-project="{{.Project}}" data-count="{{.EnvOverrides}}" data-key="{{.Project}}/envreset">Reset to project defaults</button>{{end}}</div>
<div class="stack-actions">
{{if not $live}}<button type="button" class="btn" data-action="up" data-project="{{.Project}}" data-key="{{.Project}}/up">Start</button>{{end}}
{{if and $live $app}}<a class="btn" href="{{$app.URL}}" target="_blank" rel="noopener" data-key="{{.Project}}/open" title="{{$app.URL}}">Open App</a>{{end}}
{{if $live}}<button type="button" class="btn btn-ghost mobile-hide" data-action="down" data-project="{{.Project}}" data-key="{{.Project}}/down" title="Stop (keeps volumes)">Stop</button>{{end}}
<div class="menu-anchor"><button type="button" class="btn btn-ghost btn-icon" data-key="{{.Project}}/menu" aria-haspopup="menu" aria-expanded="false" aria-label="More actions for {{$name}}" title="More actions"><span aria-hidden="true">&#8943;</span></button><div class="menu" role="menu" hidden>
{{if eq .State "partial"}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/menu/up" data-action="up" data-project="{{.Project}}"><span class="menu-label">Start stopped services</span></button>{{end}}
{{if $live}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/menu/restart" data-action="restart" data-project="{{.Project}}"><span class="menu-label">Restart</span></button>
<button type="button" role="menuitem" class="menu-item mobile-only" tabindex="-1" data-key="{{.Project}}/menu/down" data-action="down" data-project="{{.Project}}"><span class="menu-label">Stop</span></button>{{end}}
{{with .LastRunMenu}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$p}}/menu/lastrun" data-run-log data-project="{{$p}}" data-run-id="{{.Run}}" data-step=""><span class="menu-label">Last run</span><span class="menu-cmd mono">{{.Text}}</span></button>{{end}}
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/menu/path" data-copy="{{.Root}}"><span class="menu-label">Copy path</span></button>
{{if $hint}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/menu/host" data-copy="{{$hint}}" title="{{$hint}}"><span class="menu-label">How to run the host app</span><span class="menu-cmd mono">{{$hint}}</span></button>{{end}}
{{if .EnvBlock}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/menu/env" data-copy="{{.EnvBlock}}" data-copy-kind="env_block" data-copy-project="{{.Project}}"><span class="menu-label">Copy .env for host app</span></button>{{end}}
{{range $i, $c := warningCommands .Commands}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$p}}/menu/cmd{{$i}}" {{if runnable $c}}data-run{{else}}data-copy{{end}}="{{$c}}"><span class="menu-label">{{if runnable $c}}Run command{{else}}Copy command{{end}}</span><span class="menu-cmd mono">{{$c}}</span></button>{{end}}
{{$down := index .Commands 0}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/menu/copydown" data-copy="{{$down}}"><span class="menu-label">Copy down command</span><span class="menu-cmd mono">{{$down}}</span></button>
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/menu/reset" data-repo-action="reset" data-repo="{{repoRoot .Root}}" data-path="{{.Root}}" title="deletes this environment's volumes and starts it again from the code in the worktree; asks first"><span class="menu-label">Reset environment&hellip;</span></button>
{{if .FromMain}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/menu/resetmain" data-repo-action="reset" data-from-main="1" data-repo="{{repoRoot .Root}}" data-path="{{.Root}}" title="deletes this environment's volumes, moves this worktree's adapter files aside and starts it with the main checkout's recipe; asks first"><span class="menu-label">Reset from main checkout&hellip;</span></button>{{end}}
<hr class="menu-sep" role="separator">
<button type="button" role="menuitem" class="menu-item menu-item-danger" tabindex="-1" data-key="{{.Project}}/menu/remove" data-run="{{$down}} --forget"><span class="menu-label">Remove instance and data</span><span class="menu-cmd mono">{{$down}} --forget</span></button>
</div></div>
</div>
<div class="stack-meta mono"><span class="stack-path" title="{{.Root}}">{{or .RelRoot .Root}}</span>{{if .Hostname}}<span class="stack-sep" aria-hidden="true"> &middot; </span><span class="stack-host" title="{{.Hostname}}">{{.Hostname}}</span>{{end}}</div>
</div>
</header>
{{if .Apps}}<div class="app-strip">{{range $i, $a := .Apps}}{{if or (eq .Source "entry") (eq .Source "link")}}{{if and .URL .Running}}<a class="app-chip app-chip-link" data-key="{{$p}}/app/{{.Label}}" href="{{.URL}}" target="_blank" rel="noopener" aria-label="Open {{.Label}} in a new tab" title="{{.URL}}{{if .Direct}} (direct: {{.Direct}}){{end}}">{{.Label}} →</a>{{else if .Warning}}<span class="app-chip app-chip-link stopped app-chip-warn" role="link" aria-disabled="true" tabindex="0" data-key="{{$p}}/app/{{.Label}}" aria-label="{{.Label}} unavailable: {{.Warning}}" title="{{.Warning}}"><span class="chip-glyph" aria-hidden="true">▲</span>{{.Label}} →</span>{{else}}<span class="app-chip app-chip-link stopped" role="link" aria-disabled="true" tabindex="0" data-key="{{$p}}/app/{{.Label}}" aria-label="{{.Label}} is not running" title="{{or .Hint "Starts with the stack"}}">{{.Label}} →</span>{{end}}{{else if and .URL .Running}}<a class="app-chip" data-key="{{$p}}/app{{$i}}" href="{{.URL}}" target="_blank" rel="noopener" title="{{.URL}}{{if .Direct}} (direct: {{.Direct}}){{end}}">{{.Label}}</a>{{else if .URL}}<span class="app-chip stopped" title="Starts with the stack">{{.Label}}</span>{{else if eq .Source "knowledge"}}<span class="app-chip stopped host" title="{{.Hint}}">{{.Label}} &middot; on host</span>{{else if .Hint}}<span class="app-chip stopped" title="Starts with the stack">{{.Label}} &middot; {{.Hint}}</span>{{else}}<span class="app-chip stopped" title="Starts with the stack">{{.Label}}</span>{{end}}{{end}}</div>{{end}}
{{if .SeedCommand}}<div class="callout callout-failed" data-seed="failed"><span class="callout-glyph" aria-hidden="true">&#8856;</span><div class="callout-body"><p class="callout-title">Database seed failed</p><p class="callout-detail">Retry runs it again. If the app already has its data, mark it as seeded instead.</p>{{if .SeedError}}<pre class="mono-log" tabindex="0" data-key="{{.Project}}/seed/log" aria-label="Seed output">{{.SeedError}}</pre>{{end}}</div><div class="callout-actions"><button type="button" class="btn" data-run="{{.SeedCommand}}" data-key="{{.Project}}/seed/retry" title="{{.SeedCommand}}">Retry seed</button><div class="menu-anchor"><button type="button" class="btn btn-ghost btn-icon" data-key="{{.Project}}/seed/menu" aria-haspopup="menu" aria-expanded="false" aria-label="More seed actions for {{$name}}" title="More seed actions"><span aria-hidden="true">&#8943;</span></button><div class="menu" role="menu" hidden>
{{if .SeedRun}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/seed/viewlog" data-run-log data-project="{{.Project}}" data-run-id="{{.SeedRun}}" data-step="{{.SeedStep}}"><span class="menu-label">View log</span></button>{{end}}
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Project}}/seed/done" data-run="{{.SeedDone}}"><span class="menu-label">Mark as seeded</span><span class="menu-cmd mono">{{.SeedDone}}</span></button>
<hr class="menu-sep" role="separator">
<button type="button" role="menuitem" class="menu-item menu-item-danger" tabindex="-1" data-key="{{.Project}}/seed/force" data-run="{{.SeedForce}}"><span class="menu-label">Re-seed, overwriting data</span><span class="menu-cmd mono">{{.SeedForce}}</span></button>
</div></div></div></div>{{end}}
{{with .RunCallout}}<div class="callout callout-{{.Tone}}" data-run-outcome="{{$inst.LastRun.Outcome}}"><span class="callout-glyph" aria-hidden="true">{{.Glyph}}</span><div class="callout-body"><p class="callout-title">{{.Title}}{{if .Step}} <code class="mono">{{.Step}}</code>{{end}}</p>{{if .Tail}}<pre class="mono-log" tabindex="0" data-key="{{$p}}/run/log" aria-label="Output of step {{.Step}}">{{.Tail}}</pre>{{end}}</div><div class="callout-actions">{{if .RetryLive}}<button type="button" class="btn" data-live-op="resume" data-repo="{{.Repo}}" data-key="{{$p}}/run/retry" title="Resume live mode">Resume</button>{{else if .RetryStart}}<button type="button" class="btn" data-repo-action="{{.RetryAction}}"{{if .FromMain}} data-from-main="1"{{end}} data-repo="{{.Repo}}" data-path="{{$inst.Root}}" data-key="{{$p}}/run/retry" title="{{.RetryTitle}}">Retry</button>{{else if .CanRetry}}<button type="button" class="btn" data-run="{{.Retry}}" data-key="{{$p}}/run/retry" title="{{.Retry}}">Retry</button>{{end}}{{if .Step}}<div class="menu-anchor"><button type="button" class="btn btn-ghost btn-icon" data-key="{{$p}}/run/menu" aria-haspopup="menu" aria-expanded="false" aria-label="More run actions for {{$name}}" title="More run actions"><span aria-hidden="true">&#8943;</span></button><div class="menu" role="menu" hidden>
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$p}}/run/viewlog" data-run-log data-project="{{$p}}" data-run-id="{{.Run}}" data-step="{{.Step}}"><span class="menu-label">View log</span></button>
</div></div>{{end}}</div></div>{{end}}
{{if .Warnings}}<div class="callout callout-attention" data-callout="warnings"><span class="callout-glyph" aria-hidden="true">&#9650;</span><div class="callout-body"><ul class="warnings">{{range .Warnings}}<li class="warning">{{.}}</li>{{end}}</ul></div>{{if .RecipeGap}}<div class="callout-actions"><button type="button" class="btn" data-repo-action="reset" data-from-main="1" data-repo="{{repoRoot .Root}}" data-path="{{.Root}}" data-key="{{.Project}}/warnings/resetmain" title="deletes this environment's volumes, moves this worktree's adapter files aside and starts it with the main checkout's recipe; asks first">Reset from main checkout&hellip;</button></div>{{end}}</div>{{end}}
{{with .Cleanup}}{{template "cleanupnote" .}}{{end}}
{{if or .OneOffRunning .OneOffLeftover}}<div class="callout callout-attention" data-oneoff="1"><span class="callout-glyph" aria-hidden="true">&#9650;</span><div class="callout-body">{{if .OneOffRunning}}<p class="callout-detail">{{plural .OneOffRunning "one-off task"}} running</p>{{end}}{{if .OneOffLeftover}}<p class="callout-detail">{{plural .OneOffLeftover "leftover one-off container"}}{{if .OneOffCleanup}} <span class="mono">{{.OneOffCleanup}}</span>{{end}}</p>{{end}}</div>{{if and .OneOffLeftover .OneOffCleanup}}<div class="callout-actions"><button type="button" class="btn" data-run="{{.OneOffCleanup}}" data-key="{{.Project}}/oneoff/clean" title="{{.OneOffCleanup}}">Clean up</button></div>{{end}}</div>{{end}}
<div class="stack-body" id="body-{{domID .Project}}">
{{if .Services}}<table class="service-table"><caption class="sr-only">Services of {{$name}}</caption><colgroup><col class="col-service"><col class="col-state"><col class="col-endpoints"><col class="col-actions"></colgroup><thead><tr><th scope="col" class="micro">Service</th><th scope="col" class="micro">State</th><th scope="col" class="micro">Endpoints</th><th scope="col" class="micro">Actions</th></tr></thead>
{{range .Services}}{{$svc := .}}<tbody class="service-group">
<tr class="service-row" data-service="{{.Name}}">
<td class="cell-service"><span class="service-logo" data-kind="{{.Kind}}"></span><div class="service-text"><button type="button" class="service-name" data-toggle-settings data-key="{{$p}}/{{.Name}}/settings" aria-expanded="false">{{if .Label}}{{.Label}}{{else}}{{.Name}}{{end}}</button>{{if eq .State "optional"}}<span class="service-image mono">not started (optional)</span>{{else if .Image}}<span class="service-image mono" title="{{.Image}}">{{.Image}}</span>{{end}}{{if .Meta}}<span class="service-meta mono">{{.Meta}}</span>{{end}}</div></td>
<td class="cell-state">{{template "chip" serviceChip .}}</td>
<td class="cell-endpoints">{{if or .Endpoints .ConnectionURL .UseCommands}}<div class="endpoints">
{{range $i, $e := .Endpoints}}{{if .Known}}{{if or (eq .Scheme "http") (eq .Scheme "https")}}<a class="endpoint-link{{if ne $svc.State "running"}} stopped{{end}}" data-key="{{$p}}/{{$svc.Name}}/ep{{$i}}" href="{{.URL}}" target="_blank" rel="noopener" title="{{.URL}}"><span class="endpoint-url">{{.URL}}</span>{{$note := endpointNote $svc.State .Proxied}}{{if $note}}<span class="endpoint-note">{{$note}}</span>{{end}}</a>{{else}}<button type="button" class="endpoint-copy copyable{{if ne $svc.State "running"}} stopped{{end}}" data-key="{{$p}}/{{$svc.Name}}/ep{{$i}}" data-copy="{{.URL}}" title="click to copy">{{.URL}}{{$note := endpointNote $svc.State false}}{{if $note}} {{$note}}{{end}}</button>{{end}}{{else}}<span class="endpoint-pending" title="container port {{.Container}}">port assigned on start</span>{{end}}{{end}}
{{if .ConnectionURL}}<button type="button" class="endpoint-copy copyable connection-url" data-key="{{$p}}/{{$svc.Name}}/conn" data-copy="{{.ConnectionURL}}" data-copy-kind="database_url" data-copy-project="{{$p}}" data-copy-service="{{$svc.Name}}" title="click to copy the connection URL ({{.ConnectionURL}})">connection URL</button>{{end}}
{{range $i, $u := .UseCommands}}<button type="button" class="endpoint-copy copyable use-command" data-key="{{$p}}/{{$svc.Name}}/use{{$i}}" data-copy="{{.Value}}" data-copy-kind="cli" data-copy-project="{{$p}}" data-copy-service="{{$svc.Name}}" title="click to copy: {{.Value}}">{{.Label}}</button>{{end}}
</div>{{else}}<span class="endpoint-none">&mdash;</span>{{end}}</td>
<td class="cell-actions"><div class="row-actions"><button type="button" class="btn btn-ghost logs-button mobile-hide" data-project="{{$p}}" data-service="{{.Name}}" data-key="{{$p}}/{{.Name}}/logs">Logs</button><div class="menu-anchor"><button type="button" class="btn btn-ghost btn-icon" data-key="{{$p}}/{{.Name}}/menu" aria-haspopup="menu" aria-expanded="false" aria-label="More actions for {{if .Label}}{{.Label}}{{else}}{{.Name}}{{end}}" title="More actions"><span aria-hidden="true">&#8943;</span></button><div class="menu" role="menu" hidden>
{{if or (eq .State "running") (eq .State "starting")}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$p}}/{{.Name}}/menu/stop" data-action="service-stop" data-project="{{$p}}" data-service="{{.Name}}"><span class="menu-label">Stop</span></button>{{else}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$p}}/{{.Name}}/menu/start" data-action="service-start" data-project="{{$p}}" data-service="{{.Name}}"><span class="menu-label">Start</span></button>{{end}}
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$p}}/{{.Name}}/menu/restart" data-action="restart" data-project="{{$p}}" data-service="{{.Name}}"><span class="menu-label">Restart</span></button>
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$p}}/{{.Name}}/menu/env" data-env-open data-project="{{$p}}" data-service="{{.Name}}"><span class="menu-label">Environment&hellip;</span></button>
<button type="button" role="menuitem" class="menu-item logs-button mobile-only" tabindex="-1" data-key="{{$p}}/{{.Name}}/menu/logs" data-project="{{$p}}" data-service="{{.Name}}"><span class="menu-label">Logs</span></button>
</div></div></div></td>
</tr>
<tr class="service-settings" hidden><td colspan="4">
{{if .Ports}}<div class="setting-row"><span class="setting-label">Ports</span><span class="setting-values">{{range .Ports}}<span class="setting-value">{{.Container}}{{if .Host}} &rarr; {{.Host}}{{end}}/{{.Protocol}}</span>{{end}}</span></div>{{end}}
{{if .Volumes}}<div class="setting-row"><span class="setting-label">Volumes</span><span class="setting-values">{{range .Volumes}}<span class="setting-value">{{.Name}} &rarr; {{.Path}}{{if .ReadOnly}} (ro){{end}}</span>{{end}}</span></div>{{end}}
{{if .Healthcheck}}<div class="setting-row"><span class="setting-label">Healthcheck</span><code class="setting-value">{{.Healthcheck}}</code></div>{{end}}
{{if .DependsOn}}<div class="setting-row"><span class="setting-label">Depends on</span><span class="setting-values">{{range .DependsOn}}<span class="setting-value">{{.}}</span>{{end}}</span></div>{{end}}
{{if .Replicas}}<div class="setting-row"><span class="setting-label">Replicas</span><span class="setting-value">{{.Replicas}}</span></div>{{end}}
{{if .EnvKeys}}<div class="setting-row"><span class="setting-label">Environment</span><span class="setting-values">{{range .EnvKeys}}<span class="setting-value">{{.}}</span>{{end}}</span></div>{{end}}
{{if $inst.Files}}<div class="setting-row"><span class="setting-label">Source files</span><span class="setting-values">{{range $inst.Files}}<span class="setting-value">{{.}}</span>{{end}}</span></div>{{end}}
</td></tr>
</tbody>{{end}}
</table>{{end}}
</div>
</article>
{{end}}
