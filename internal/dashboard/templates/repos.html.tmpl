{{define "repos"}}
<div id="repos-meta" data-configured="{{.Configured}}" data-scanning="{{.Scanning}}" data-count="{{len .Repos}}" hidden></div>
{{if not .Configured}}
<div class="empty-state">
  <h2>Pick the folder that holds your repos</h2>
  <p class="muted">stackfork scans it for git repositories and shows their worktrees and branches here.</p>
  <p class="empty-actions"><button type="button" class="btn btn-primary" data-goto="settings" data-key="empty/add-folder">Add folder</button></p>
  <p class="command-row"><code class="mono copyable" data-copy="stackfork config add-root PATH" title="click to copy">stackfork config add-root PATH</code></p>
</div>
{{else if not .Repos}}
{{if .Scanning}}
<div class="repo-table" aria-busy="true">
  <div class="repo-head micro" aria-hidden="true"><span>Repo</span><span>Status</span><span class="num">Worktrees</span><span class="num">Branches</span><span class="num">Last activity</span><span></span></div>
  <div class="skeleton-row" aria-hidden="true"></div><div class="skeleton-row" aria-hidden="true"></div><div class="skeleton-row" aria-hidden="true"></div><div class="skeleton-row" aria-hidden="true"></div><div class="skeleton-row" aria-hidden="true"></div>
</div>
<p class="muted" role="status">Scanning folders&hellip;</p>
{{else}}
<div class="empty-state">
  <h2>No git repositories found</h2>
  <p class="muted">Nothing under the configured folders is a git repository.</p>
  <p class="empty-actions"><button type="button" class="btn" data-rescan data-key="empty/rescan">Rescan</button> <button type="button" class="btn btn-ghost" data-goto="settings" data-key="empty/change-folders">Change folders</button></p>
</div>
{{end}}
{{else}}
{{$first := .FirstSetup}}
<div class="repo-table">
  <div class="repo-head micro" aria-hidden="true"><span>Repo</span><span>Status</span><span class="num">Worktrees</span><span class="num">Branches</span><span class="num">Last activity</span><span></span></div>
  <div id="repo-rows">
  {{range $i, $row := .Rows}}{{$r := $row.Repo}}{{$c := repoChip $r}}
  {{$ready := eq $r.Readiness "ready"}}
  <div class="repo" data-key="{{$r.Path}}" data-search="{{$row.Search}}" data-ready="{{if $ready}}1{{else}}0{{end}}" data-name="{{$r.Name}}" data-folder="{{$r.Group}}" data-rank="{{$i}}" data-open="0">
    <div class="repo-row">
      <button type="button" class="repo-toggle" data-key="{{$r.Path}}/toggle" data-toggle-repo aria-expanded="false" aria-controls="repo-panel-{{$i}}" title="{{$r.Path}}">
        <span class="chevron-glyph" aria-hidden="true"></span>
        <span class="repo-id"><span class="repo-name">{{$r.Name}}</span>{{if and $row.Live.Show $row.Live.Enabled}}<span class="live-tag{{if eq $row.Live.State "paused"}} live-tag-attention{{end}}" title="Live mode: {{$row.Live.Chip.Label}}">Live</span>{{end}}{{if $r.Group}}<span class="repo-folder">{{$r.Group}}</span>{{end}}</span>
      </button>
      <span class="repo-status"><span class="chip chip-{{$c.Class}}" title="{{if $c.Title}}{{$c.Title}}{{else}}{{$r.ReadinessReason}}{{end}}"><span class="chip-glyph" aria-hidden="true">{{$c.Glyph}}</span>{{$c.Label}}</span></span>
      <span class="repo-counts">
        <span class="repo-num"><span class="num">{{len $r.Worktrees}}</span><span class="unit">{{if eq (len $r.Worktrees) 1}} worktree{{else}} worktrees{{end}}</span></span><span class="sep" aria-hidden="true">&middot;</span>
        <span class="repo-num"><span class="num">{{len $r.Branches}}</span><span class="unit">{{if eq (len $r.Branches) 1}} branch{{else}} branches{{end}}</span></span><span class="sep" aria-hidden="true">&middot;</span>
        <span class="repo-last" title="{{stamp $r.LastCommit}}">{{ago $r.LastCommit}}</span>
      </span>
      <span class="repo-actions">
        {{if $ready}}<button type="button" class="btn" data-key="{{$r.Path}}/start" data-toggle-repo data-open-only title="Pick a branch or worktree to start">Start&hellip;</button>
        {{else}}<button type="button" class="btn{{if eq $first $r.Path}} btn-primary{{end}} learn-btn" data-key="{{$r.Path}}/setup" data-repo="{{$r.Path}}" data-name="{{$r.Name}}" data-prompt="{{prompt $r.Name $r.Path $r.DefaultBranch}}" title="{{$r.ReadinessReason}}">Set up</button>{{end}}
        <div class="menu-anchor"><button type="button" class="btn btn-ghost btn-icon" data-key="{{$r.Path}}/menu" aria-haspopup="menu" aria-expanded="false" aria-label="More actions for {{$r.Name}}" title="More actions"><span aria-hidden="true">&#8943;</span></button><div class="menu" role="menu" hidden>
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$r.Path}}/menu/fetch" data-repo-action="fetch" data-repo="{{$r.Path}}" title="git fetch --prune in this repo only"><span class="menu-label">Fetch</span></button>
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$r.Path}}/menu/path" data-copy="{{$r.Path}}"><span class="menu-label">Copy path</span><span class="menu-cmd mono">{{tilde $r.Path}}</span></button>
{{if not $ready}}<button type="button" role="menuitem" class="menu-item learn-btn" tabindex="-1" data-key="{{$r.Path}}/menu/learn" data-repo="{{$r.Path}}" data-name="{{$r.Name}}" data-prompt="{{prompt $r.Name $r.Path $r.DefaultBranch}}" title="open Claude Code, Codex or Copilot CLI in a terminal to learn and verify how this project starts (once per project)"><span class="menu-label">Learn with your agent</span></button>
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$r.Path}}/menu/prompt" data-copy="{{prompt $r.Name $r.Path $r.DefaultBranch}}"><span class="menu-label">Copy prompt</span></button>{{end}}
</div></div>
      </span>
    </div>
    <div class="repo-panel" id="repo-panel-{{$i}}" hidden>
      <div class="repo-errors" data-repo-errors></div>
      <p class="repo-meta"><span class="mono" title="{{$r.Path}}">{{tilde $r.Path}}</span><span class="dot" aria-hidden="true">&middot;</span><span>default <code class="mono">{{$r.DefaultBranch}}</code></span></p>
      {{with $row.Live}}{{if .Show}}
      <div class="live-bar" data-live="{{.State}}" data-live-repo="{{$r.Path}}">
        <button type="button" role="switch" class="switch" aria-checked="{{.Enabled}}" data-live-op="{{if .Enabled}}off{{else}}on{{end}}" data-repo="{{$r.Path}}" data-key="{{$r.Path}}/live"{{if eq .State "elsewhere"}} disabled title="Another dashboard runs live mode"{{end}} aria-label="Live mode for {{$r.Name}}"><span class="switch-track" aria-hidden="true"><span class="switch-thumb"></span></span><span class="switch-label">Live</span></button>
        <span class="chip chip-{{.Chip.Class}}"{{if .Chip.Title}} title="{{.Chip.Title}}"{{end}}><span class="chip-glyph" aria-hidden="true">{{.Chip.Glyph}}</span>{{.Chip.Label}}</span>
        {{if eq .State "paused"}}<span class="small muted live-reason">{{.Reason}}</span>
        <button type="button" class="btn" data-live-op="resume" data-repo="{{$r.Path}}" data-key="{{$r.Path}}/live/resume">Resume</button>
        {{if .Trust}}<button type="button" class="btn" data-key="{{$r.Path}}/live/trust" data-run="stackfork --root {{shq $r.Path}} plan --trust" title="asks for confirmation and shows every step it trusts">Trust on this machine</button>{{end}}{{end}}
        {{if .Enabled}}<span class="live-cleanup"><label class="plan-mode"><span class="small muted">Branch cleanup</span> <select data-cleanup-for="{{$r.Path}}" data-key="{{$r.Path}}/cleanup" aria-label="Branch cleanup for {{$r.Name}}">{{$m := .Setting.Mode}}{{range $.CleanupModes}}<option value="{{.}}"{{if eq . $m}} selected{{end}}>{{.}}</option>{{end}}</select></label>
        {{if eq .Setting.Mode "auto"}}<label class="plan-mode"><span class="small muted">after</span> <input type="number" min="1" max="720" value="{{.Setting.GraceHours}}" data-cleanup-grace data-key="{{$r.Path}}/cleanup/grace" aria-label="Grace period in hours for {{$r.Name}}"> <span class="small muted">h</span></label>{{end}}
        {{if ne .Setting.Mode "off"}}<label class="plan-mode"><input type="checkbox" data-cleanup-delete data-key="{{$r.Path}}/cleanup/delete"{{if .Setting.DeleteBranch}} checked{{end}} aria-label="Also delete the local branch of {{$r.Name}}"> <span class="small muted">delete branch</span></label>{{end}}</span>{{end}}
      </div>
      {{if .Trust}}{{if .Diff}}<pre class="mono-log live-diff">{{range .Diff}}{{.}}
{{end}}</pre>{{end}}{{end}}
      {{end}}{{end}}
      {{if not $ready}}
      <div class="callout" data-setup-callout>
        <span class="callout-glyph" aria-hidden="true">&#9675;</span>
        <div class="callout-body"><p class="callout-title">stackfork has not verified how this project starts. Set it up once with your agent.</p><p class="callout-detail">{{$r.ReadinessReason}}</p></div>
        <div class="callout-actions"><button type="button" class="btn learn-btn" data-key="{{$r.Path}}/panel-setup" data-repo="{{$r.Path}}" data-name="{{$r.Name}}" data-prompt="{{prompt $r.Name $r.Path $r.DefaultBranch}}">Set up with your agent</button></div>
      </div>
      {{end}}
      {{with $row.Plan}}{{if .LoadError}}
      <div class="callout callout-failed" data-plan-error>
        <span class="callout-glyph" aria-hidden="true">&#9650;</span>
        <div class="callout-body"><p class="callout-title">stackfork cannot read this repo's startup plan</p><p class="callout-detail mono">{{.LoadError}}</p></div>
      </div>
      {{else}}
      <div class="plan" data-plan="{{.Status}}">
        <div class="plan-bar">
          {{if .Derived}}<span class="plan-derived"><span class="small">derived — not recorded; run learn to record it</span>{{if $ready}} <button type="button" class="btn btn-ghost learn-btn" data-key="{{$r.Path}}/derived-learn" data-repo="{{$r.Path}}" data-name="{{$r.Name}}" data-prompt="{{prompt $r.Name $r.Path $r.DefaultBranch}}">Learn with your agent</button>{{end}}</span>
          {{else}}<span class="micro">Starts with</span>{{end}}
          <label class="plan-mode"><span class="small muted">Mode</span> {{if or .Unsupported (gt (len .Modes) 1)}}<select data-mode-for="{{$r.Path}}" data-key="{{$r.Path}}/mode" aria-label="Start mode for {{$r.Name}}">{{$m := .Mode}}{{range .Modes}}<option value="{{.}}"{{if eq . $m}} selected{{end}}>{{.}}</option>{{end}}</select>{{else}}<code class="mono" data-mode-label>{{.Mode}}</code>{{end}}{{if .Unsupported}} <span class="chip chip-attention"><span class="chip-glyph" aria-hidden="true">&#9679;</span>{{.Mode}} not supported by this plan</span>{{end}}</label>
        </div>
        {{template "entryline" $row}}
        {{if .Refusal}}
        <div class="callout callout-attention" data-plan-refusal>
          <span class="callout-glyph" aria-hidden="true">&#9679;</span>
          <div class="callout-body"><p class="callout-title">A Start would be refused</p><p class="callout-detail">{{.Refusal}}</p></div>
        </div>
        {{else}}
        <div class="plan-list" role="table" aria-label="Startup plan, {{.Mode}} mode">
          <div class="plan-head micro" role="row"><span role="columnheader">Step</span><span role="columnheader">Kind</span><span role="columnheader">Command</span><span role="columnheader">State</span></div>
          {{range .Steps}}{{template "planrow" .}}{{end}}
          {{range .Skipped}}{{template "planrow" .}}{{end}}
          <div class="plan-live mono" data-live-for="" aria-live="polite"></div>
        </div>
        {{end}}
        {{if .Gap}}
        <div class="callout callout-attention" data-plan-gap>
          <span class="callout-glyph" aria-hidden="true">&#9679;</span>
          <div class="callout-body"><p class="callout-title">This worktree prepares with fewer Compose files</p><p class="callout-detail">{{.Gap}}</p></div>
        </div>
        {{end}}
        {{if and .Diff (not .NeedsTrust)}}
        <div class="plan-note" data-trust-note>
          <span class="chip chip-off"><span class="chip-glyph" aria-hidden="true">&#9675;</span>not trusted</span>
          <span class="small muted">Host steps are not trusted on this machine (needed only in hybrid mode)</span>
          <div class="menu-anchor"><button type="button" class="btn btn-ghost btn-icon" data-key="{{$r.Path}}/trust-menu" aria-haspopup="menu" aria-expanded="false" aria-label="Trust actions for {{$r.Name}}" title="More actions"><span aria-hidden="true">&#8943;</span></button><div class="menu menu-left" role="menu" hidden>
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$r.Path}}/trust" data-run="stackfork --root {{shq $r.Path}} plan --trust" title="asks for confirmation and shows every step it trusts"><span class="menu-label">Trust on this machine</span><span class="menu-cmd mono">stackfork plan --trust</span></button>
</div></div>
        </div>
        {{else if .Diff}}
        <div class="callout callout-failed" data-trust-callout>
          <span class="callout-glyph" aria-hidden="true">&#9650;</span>
          <div class="callout-body"><p class="callout-title">{{.TrustTitle}}</p><pre class="mono-log">{{range .Diff}}{{.}}
{{end}}</pre></div>
          <div class="callout-actions"><button type="button" class="btn" data-key="{{$r.Path}}/trust" data-run="stackfork --root {{shq $r.Path}} plan --trust">Trust on this machine</button></div>
        </div>
        {{end}}
      </div>
      {{end}}
      {{else}}
      {{template "entryline" $row}}

      {{end}}

      {{with $row.Secrets}}
      <section class="secrets" aria-labelledby="secrets-h-{{$i}}">
        <div class="secrets-bar">
          <h3 class="micro" id="secrets-h-{{$i}}">Secrets</h3>
          <span class="small muted">Names and status only. A value never reaches this page.</span>
          <button type="button" class="btn secrets-check" data-secrets-check data-repo="{{$r.Path}}" data-key="{{$r.Path}}/secrets/check" title="Read every reference once; 1Password may ask you to unlock it">Check</button>
        </div>
        <div class="secret-list" role="table" aria-label="Secrets of {{$r.Name}}">
          <div class="secret-head micro" role="row"><span role="columnheader">Name</span><span role="columnheader">Reference</span><span role="columnheader">Status</span><span role="columnheader"><span class="sr-only">Actions</span></span></div>
          {{range .}}
          <div class="secret-row" role="row" data-key="{{.Repo}}/secret/{{.Name}}">
            <span class="secret-name" role="cell"><span class="mono secret-id">{{.Name}}</span>{{if .Hint}}<span class="small muted secret-hint">{{.Hint}}</span>{{end}}</span>
            <span class="secret-ref" role="cell">{{if .Reference}}<code class="mono">{{.Reference}}</code>{{else}}<span class="small muted">not mapped on this machine</span>{{end}}</span>
            <span class="secret-state" role="cell"><span class="chip chip-{{.Chip.Class}}"{{if .Chip.Title}} title="{{.Chip.Title}}"{{end}}><span class="chip-glyph" aria-hidden="true">{{.Chip.Glyph}}</span>{{.Chip.Label}}</span></span>
            <span class="secret-actions" role="cell"><div class="menu-anchor"><button type="button" class="btn btn-ghost btn-icon" data-key="{{.Repo}}/secret/{{.Name}}/menu" aria-haspopup="menu" aria-expanded="false" aria-label="More actions for {{.Name}}" title="More actions"><span aria-hidden="true">&#8943;</span></button><div class="menu" role="menu" hidden>
{{if .CanSet}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Repo}}/secret/{{.Name}}/menu/set" data-secret-set data-repo="{{.Repo}}" data-name="{{.Name}}" title="Opens a hidden-answer dialog on this Mac; the value does not pass through this page"><span class="menu-label">Set value&hellip;</span><span class="menu-cmd mono">keychain:{{.Item}}</span></button>{{end}}
{{if .SetCmd}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Repo}}/secret/{{.Name}}/menu/setcmd" data-copy="{{.SetCmd}}"><span class="menu-label">Copy set command</span><span class="menu-cmd mono">{{.SetCmd}}</span></button>{{end}}
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Repo}}/secret/{{.Name}}/menu/map" data-copy="{{.MapCmd}}"><span class="menu-label">Copy map command</span><span class="menu-cmd mono">{{.MapCmd}}</span></button>
{{if .Unmap}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{.Repo}}/secret/{{.Name}}/menu/unmap" data-copy="{{.Unmap}}"><span class="menu-label">Copy unmap command</span><span class="menu-cmd mono">{{.Unmap}}</span></button>{{end}}
</div></div></span>
          </div>
          {{end}}
        </div>
      </section>
      {{end}}

      <div class="wt-table">
        <div class="wt-head micro" aria-hidden="true"><span>Lane</span><span>Branch</span><span>Path</span><span>Ahead / behind upstream</span><span>State</span><span></span></div>
        {{$nwt := len $r.Worktrees}}
        {{range $j, $w := $r.Worktrees}}{{$lane := laneOf $r $w}}
        <div class="wt-row{{if $lane}} lane-{{$lane}}{{end}}{{if $w.Main}} wt-main{{end}}{{if isLast $j $nwt}} wt-last{{end}}" data-key="{{$r.Path}}/wt/{{$w.Path}}">
          <span class="wt-lane" aria-hidden="true"><svg width="24" height="100%" focusable="false"><rect class="lane-trunk" x="11" y="0" width="2" height="100%"/>{{if not $w.Main}}<rect class="lane-stub{{if not $lane}} lane-none{{end}}" x="11" y="50%" width="9" height="2"/>{{end}}<circle class="lane-dot{{if not $lane}} lane-none{{end}}" cx="{{if $w.Main}}12{{else}}20{{end}}" cy="50%" r="3"/></svg></span>
          <span class="wt-branch">
            {{if detached $w.Branch}}<span class="branch-pill{{if not $lane}} branch-pill-plain{{end}}" title="{{$w.Branch}}">detached @ <span class="mono">{{shortSha $w.Branch}}</span></span>
            {{else}}<span class="branch-pill{{if not $lane}} branch-pill-plain{{end}}" title="{{$w.Branch}}">{{$w.Branch}}</span>{{end}}
            {{if $w.Main}}<span class="chip chip-off">main checkout</span>{{end}}
            {{if $w.Dirty}}<span class="chip chip-attention" title="uncommitted changes"><span class="chip-glyph" aria-hidden="true">&#9679;</span>changes</span>{{end}}
          </span>
          <span class="wt-path mono" title="{{$w.Path}}">{{relPath $r.Path $w.Path}}</span>
          <span class="wt-ab">{{template "aheadbehind" $w}}</span>
          {{$lw := $row.Live.WorktreeFor $w.Path}}<span class="wt-state"{{if and $lw $lw.Behind}} title="&#9650; {{$lw.Behind}}"{{else if and $lw $lw.Switched}} title="&#9650; Branch switched"{{end}}>{{if $w.Instance}}{{$c := stateChip $w.Instance.State}}<a href="#" class="instance-link" data-project="{{$w.Instance.Project}}" data-key="{{$r.Path}}/wt/{{$w.Path}}/state" title="Show {{$w.Instance.Project}} on Instances"><span class="chip chip-{{$c.Class}}"><span class="chip-glyph" aria-hidden="true">{{$c.Glyph}}</span>{{$c.Label}}</span></a>{{else}}<span class="chip chip-off"><span class="chip-glyph" aria-hidden="true">&#9675;</span>No stack</span>{{end}}</span>
          <span class="wt-actions">
            {{if and $w.Instance (isRunning $w.Instance.State)}}<a href="#" class="btn instance-link" data-project="{{$w.Instance.Project}}" data-key="{{$r.Path}}/wt/{{$w.Path}}/show">Show instance</a>
            {{else if $ready}}<button type="button" class="btn" data-key="{{$r.Path}}/wt/{{$w.Path}}/start" data-repo-action="start" data-repo="{{$r.Path}}" data-path="{{$w.Path}}">Start</button>
            {{else}}<button type="button" class="btn" disabled title="Set up this repo first">Start</button>{{end}}
            <div class="menu-anchor"><button type="button" class="btn btn-ghost btn-icon" data-key="{{$r.Path}}/wt/{{$w.Path}}/menu" aria-haspopup="menu" aria-expanded="false" aria-label="More actions for {{$w.Branch}}" title="More actions"><span aria-hidden="true">&#8943;</span></button><div class="menu" role="menu" hidden>
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$r.Path}}/wt/{{$w.Path}}/menu/path" data-copy="{{$w.Path}}"><span class="menu-label">Copy path</span><span class="menu-cmd mono">{{tilde $w.Path}}</span></button>
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$r.Path}}/wt/{{$w.Path}}/menu/cd" data-copy="cd {{shq $w.Path}}"><span class="menu-label">Copy terminal command</span><span class="menu-cmd mono">cd {{shq $w.Path}}</span></button>
{{if and $ready $w.Instance}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$r.Path}}/wt/{{$w.Path}}/menu/reset" data-repo-action="reset" data-repo="{{$r.Path}}" data-path="{{$w.Path}}" title="deletes this environment's volumes and starts it again from the code in the worktree; asks first"><span class="menu-label">Reset environment&hellip;</span></button>{{end}}
{{if and $ready $w.Instance (not $w.Main) $w.Instance.FromMain}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$r.Path}}/wt/{{$w.Path}}/menu/resetmain" data-repo-action="reset" data-from-main="1" data-repo="{{$r.Path}}" data-path="{{$w.Path}}" title="deletes this environment's volumes, moves this worktree's adapter files aside and starts it with the main checkout's recipe; asks first"><span class="menu-label">Reset from main checkout&hellip;</span></button>{{end}}
{{if not $w.Main}}<hr class="menu-sep" role="separator">
<button type="button" role="menuitem" class="menu-item menu-item-danger" tabindex="-1" data-key="{{$r.Path}}/wt/{{$w.Path}}/menu/remove" data-run="git -C {{shq $r.Path}} worktree remove {{shq $w.Path}}" title="asks for confirmation; refuses uncommitted changes{{if $w.Instance}}; the stack goes too{{end}}"><span class="menu-label">Remove worktree</span><span class="menu-cmd mono">git worktree remove {{relPath $r.Path $w.Path}}</span></button>{{end}}
</div></div>
          </span>
        </div>
        {{with $lw}}{{if or .Note .Switched}}
        <div class="callout callout-attention wt-note" data-wt-note="{{$w.Path}}"><span class="callout-glyph" aria-hidden="true">&#9650;</span><div class="callout-body"><p class="callout-title">{{if .Switched}}Branch switched{{else if .Behind}}{{.Behind}}{{else}}Live mode{{end}}</p>{{if .Note}}<p class="callout-detail">{{.Note}}</p>{{end}}{{if .Command}}<p class="command-row"><code class="mono copyable" data-copy="{{.Command}}" data-key="{{$r.Path}}/wt/{{$w.Path}}/note/cmd" title="click to copy">{{.Command}}</code></p>{{end}}</div></div>{{end}}{{end}}
        {{with $row.Live.CleanupNoteFor $w.Path}}{{template "cleanupnote" .}}{{end}}
        {{end}}
      </div>

      {{if $r.Branches}}
      <div class="wt-table wt-branches">
        <p class="wt-subhead micro">Branches not checked out</p>
        {{range $r.Branches}}
        <div class="wt-row wt-branch-row" data-key="{{$r.Path}}/br/{{.Name}}">
          <span class="wt-lane" aria-hidden="true"><svg width="24" height="100%" focusable="false"><rect class="lane-trunk lane-dashed" x="11" y="0" width="2" height="100%"/><rect class="lane-stub lane-none lane-dashed" x="11" y="50%" width="9" height="2"/><circle class="lane-dot lane-none lane-hollow" cx="20" cy="50%" r="3"/></svg></span>
          <span class="wt-branch"><span class="branch-pill branch-pill-plain" title="{{.Name}}">{{.Name}}</span></span>
          <span class="wt-path mono muted" title="last commit {{stamp .LastCommit}}">not checked out</span>
          <span class="wt-ab">{{template "aheadbehind" .}}</span>
          <span class="wt-state"><span class="chip chip-off"><span class="chip-glyph" aria-hidden="true">&#9675;</span>No stack</span></span>
          <span class="wt-actions">
            {{if $ready}}<button type="button" class="btn" data-key="{{$r.Path}}/br/{{.Name}}/start" data-repo-action="start" data-repo="{{$r.Path}}" data-branch="{{.Name}}" data-confirm="Create the worktree {{worktreeAt $r.Path .Name}} and start its environment?">Start</button>
            {{else}}<button type="button" class="btn" disabled title="Set up this repo first">Start</button>{{end}}
            <div class="menu-anchor"><button type="button" class="btn btn-ghost btn-icon" data-key="{{$r.Path}}/br/{{.Name}}/menu" aria-haspopup="menu" aria-expanded="false" aria-label="More actions for {{.Name}}" title="More actions"><span aria-hidden="true">&#8943;</span></button><div class="menu" role="menu" hidden>
{{if $ready}}<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$r.Path}}/br/{{.Name}}/menu/wt" data-repo-action="worktree-add" data-repo="{{$r.Path}}" data-branch="{{.Name}}" data-confirm="Create the worktree {{worktreeAt $r.Path .Name}} without starting it?"><span class="menu-label">Create worktree only</span><span class="menu-cmd mono">{{relPath $r.Path (worktreeAt $r.Path .Name)}}</span></button>{{end}}
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$r.Path}}/br/{{.Name}}/menu/copy" data-copy="{{.Name}}"><span class="menu-label">Copy branch name</span></button>
</div></div>
          </span>
        </div>
        {{end}}
      </div>
      {{end}}
    </div>
  </div>
  {{end}}
  </div>
</div>
{{end}}
{{end}}

{{define "entryline"}}{{with .Entry}}<div class="entry-line" data-entry="{{.State}}">{{if eq .State "none"}}<span class="small muted">No web entry</span>{{else}}<span class="micro">App</span><span aria-hidden="true">&rarr;</span>{{if .Target}}<code class="mono">{{.Target}}</code>{{else}}<span class="small muted">no entry recorded</span>{{end}}{{if eq .State "recorded"}}<span class="chip chip-ok"><span class="chip-glyph" aria-hidden="true">&#9679;</span>recorded</span>{{else}}<span class="chip chip-attention"><span class="chip-glyph" aria-hidden="true">&#9679;</span>{{if .Target}}entry guessed{{else}}no entry{{end}}</span><div class="menu-anchor"><button type="button" class="btn btn-ghost btn-icon" data-key="{{$.Path}}/entry/menu" aria-haspopup="menu" aria-expanded="false" aria-label="Entry actions for {{$.Name}}" title="More actions"><span aria-hidden="true">&#8943;</span></button><div class="menu menu-left" role="menu" hidden>
<button type="button" role="menuitem" class="menu-item" tabindex="-1" data-key="{{$.Path}}/entry/copy" data-copy="{{entryCommand .}}"><span class="menu-label">Copy command</span><span class="menu-cmd mono">{{entryCommand .}}</span></button>
</div></div>{{end}}{{end}}</div>{{end}}{{end}}
{{define "planrow"}}<div class="plan-row{{if .Skipped}} plan-skipped{{end}}" role="row" data-step="{{.ID}}"><span class="plan-id mono" role="cell">{{.ID}}</span><span class="plan-kind" role="cell">{{.Kind}}</span><span class="plan-text mono" role="cell">{{.Text}}{{if .Source}}<span class="plan-source small">{{.Source}}</span>{{end}}</span><span class="plan-state" role="cell"><span class="chip chip-{{.Chip.Class}}"{{if .Chip.Title}} title="{{.Chip.Title}}"{{end}}><span class="chip-glyph" aria-hidden="true">{{.Chip.Glyph}}</span>{{.Chip.Label}}</span><span class="plan-dur small" hidden></span></span></div><div class="plan-live mono" data-live-for="{{.ID}}" aria-live="polite"></div>{{end}}

{{define "aheadbehind"}}{{$t := aheadBehindText .Ahead .Behind .Upstream}}{{if eq .Upstream ""}}<span class="ab-none" title="this branch tracks no upstream">no upstream</span>
{{else if and (eq .Ahead 0) (eq .Behind 0)}}<span class="ab-none" title="matches {{.Upstream}}">up to date</span>
{{else}}{{$b := bar .Ahead .Behind}}<span class="ab" title="{{$t}} ({{.Upstream}})"><svg class="ab-bar" width="56" height="4" viewBox="0 0 56 4" aria-hidden="true" focusable="false"><rect class="ab-track" width="56" height="4" rx="2"/>{{if $b.Ahead}}<rect class="ab-ahead" width="{{$b.Ahead}}" height="4" rx="2"/>{{end}}{{if $b.Behind}}<rect class="ab-behind" x="{{$b.Ahead}}" width="{{$b.Behind}}" height="4" rx="2"/>{{end}}</svg><span class="mono ab-count" aria-hidden="true">{{.Ahead}} &middot; {{.Behind}}</span><span class="sr-only">{{$t}}</span></span>{{end}}{{end}}

{{define "settings"}}
<h2 class="sr-only">Settings</h2>
<div class="set-card">
<section class="set-row" aria-labelledby="set-folders">
  <div class="set-label"><h3 id="set-folders">Folders</h3><p class="muted">stackfork scans these for git repositories. Removing a folder only stops scanning it; nothing on disk is changed.</p></div>
  <div class="set-control">
    <ul class="folder-list">
      {{range .Roots}}
      <li class="folder-row"><svg class="folder-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 4.5a1 1 0 0 1 1-1h3l1.5 1.5H13a1 1 0 0 1 1 1V12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/></svg><code class="folder-path mono" title="{{.Path}}">{{.Path}}</code><span class="muted folder-count">{{.Repos}} {{if eq .Repos 1}}repo{{else}}repos{{end}}</span>
        <button type="button" class="btn btn-ghost" data-config-op="remove-root" data-value="{{.Path}}" aria-label="Remove {{.Path}}">Remove</button></li>
      {{else}}
      <li class="muted">None yet.</li>
      {{end}}
    </ul>
    <form class="settings-form" data-config-op="add-root">
      <input type="text" name="value" placeholder="/path/to/folder or ~/folder" aria-label="Folder to scan" autocomplete="off">
      <button type="submit" class="btn btn-primary">Add folder</button>
    </form>
    <p class="muted">Or in a terminal: <code class="copyable" data-copy="stackfork config add-root PATH" title="click to copy">stackfork config add-root PATH</code></p>
  </div>
</section>
<section class="set-row" aria-labelledby="set-exclude">
  <div class="set-label"><h3 id="set-exclude">Skip folders named</h3><p class="muted">node_modules, vendor, .worktrees and hidden folders are always skipped.</p></div>
  <div class="set-control">
    <ul class="folder-list">
      {{range .Exclude}}
      <li class="folder-row"><code class="folder-path mono">{{.}}</code>
        <button type="button" class="btn btn-ghost" data-config-op="remove-exclude" data-value="{{.}}" aria-label="Remove {{.}}">Remove</button></li>
      {{else}}
      <li class="muted">None.</li>
      {{end}}
    </ul>
    <form class="settings-form" data-config-op="add-exclude">
      <input type="text" name="value" placeholder="folder name, e.g. Backup" aria-label="Folder name to skip" autocomplete="off">
      <button type="submit" class="btn">Add</button>
    </form>
  </div>
</section>
<section class="set-row" aria-labelledby="set-depth">
  <div class="set-label"><h3 id="set-depth">Max depth</h3><p class="muted">How many folder levels down the scan looks.</p></div>
  <div class="set-control">
    <form class="settings-form" data-config-op="set-max-depth">
      <input type="number" name="value" min="1" max="12" value="{{.MaxDepth}}" aria-label="Maximum folder depth">
      <button type="submit" class="btn">Save</button>
    </form>
  </div>
</section>
</div>
<p class="muted set-config">Config file: <code class="mono">{{.ConfigPath}}</code></p>
{{end}}
