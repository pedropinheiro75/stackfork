<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>stackfork dashboard</title>
<link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
<script src="/static/theme-init.js"></script>
<link rel="stylesheet" href="/static/tokens.css">
<link rel="stylesheet" href="/static/app.css">
<meta name="stackfork-token" content="{{.Token}}">
</head>
<body>
<div class="app">
<nav class="rail" aria-label="Views">
  <span class="rail-mark" aria-hidden="true">s</span>
    <button type="button" class="rail-item" data-view="instances" aria-current="page" title="Instances">
      <svg class="rail-icon" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="2.5" width="12" height="4" rx="1"/><rect x="2" y="9.5" width="12" height="4" rx="1"/></svg><span class="sr-only">Instances</span><span class="rail-count" id="rail-count-instances">{{if .Loading}}&hellip;{{else}}{{.RunningCount}}/{{.Total}}{{end}}</span>
    </button>
    <button type="button" class="rail-item" data-view="repos" title="Repos">
      <svg class="rail-icon" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 4.5a1 1 0 0 1 1-1h3l1.5 1.5H13a1 1 0 0 1 1 1V12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"/></svg><span class="sr-only">Repos</span><span class="rail-count" id="rail-count-repos"></span>
    </button>
    <button type="button" class="rail-item" data-view="cleanup" title="Clean up">
      <svg class="rail-icon" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 4.5h10M6.5 4.5V3h3v1.5M4.5 4.5l.5 8.5h6l.5-8.5"/></svg><span class="sr-only">Clean up</span><span class="rail-count" id="rail-count-cleanup"></span>
    </button>
    <button type="button" class="rail-item" data-view="settings" title="Settings">
      <svg class="rail-icon" viewBox="0 0 16 16" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="2"/><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4"/></svg><span class="sr-only">Settings</span><span class="rail-count" id="rail-count-settings"></span>
    </button>
</nav>
<div class="shell">
<header class="toolbar">
  <h1 id="view-title" class="toolbar-title">Instances</h1>
  <div class="toolbar-tools" data-for="instances">
    <input id="filter" type="text" placeholder="Filter instances" aria-label="Filter instances">
    <label><input id="running-only" type="checkbox"> Running only</label>
  </div>
  <div class="toolbar-tools" data-for="repos" hidden>
    <input id="repo-filter" type="text" placeholder="Search repos and branches" aria-label="Search repos and branches">
    <label><input id="ready-only" type="checkbox"> Ready only</label>
    <button type="button" id="rescan" class="btn btn-ghost" title="Walk the folders again and re-read every repo">Rescan</button>
    <span id="scan-state" class="muted"></span>
  </div>
  <div class="system-cluster">
    <span id="docker-status" class="chip status-pill {{if .Loading}}chip-busy{{else if .Docker.Reachable}}chip-ok{{else}}chip-failed{{end}}" data-state="{{if .Loading}}busy{{else if .Docker.Reachable}}ok{{else}}failed{{end}}"><span class="status-glyph" aria-hidden="true">{{if .Loading}}&#9684;{{else if .Docker.Reachable}}&#9679;{{else}}&#9650;{{end}}</span><span class="status-text">Docker &middot; {{if .Loading}}checking&hellip;{{else if .Docker.Reachable}}ok{{else}}unreachable{{end}}</span></span>
    <span id="proxy-status" class="chip status-pill {{if .Loading}}chip-busy{{else if .Proxy.Running}}chip-ok{{else}}chip-off{{end}}" data-state="{{if .Loading}}busy{{else if .Proxy.Running}}ok{{else}}off{{end}}"><span class="status-glyph" aria-hidden="true">{{if .Loading}}&#9684;{{else if .Proxy.Running}}&#9679;{{else}}&#9675;{{end}}</span><span class="status-text">Proxy &middot; {{if .Loading}}checking&hellip;{{else if .Proxy.Running}}:{{.Proxy.Port}}{{else}}stopped{{end}}</span></span>
    <button id="proxy-start" class="btn btn-ghost" data-action="proxy-up" title="Start the proxy for portless URLs"{{if or .Loading .Proxy.Running}} hidden{{end}}>Start proxy</button>
    <button id="theme-toggle" type="button" class="btn btn-ghost" data-theme-mode="system" aria-label="Theme: system. Switch to light">Theme: system</button>
    <span id="version" class="mono">{{.Version}}</span>
  </div>
</header>

<div class="banners">
  <div id="disk-banner" class="banner banner-attention" role="alert" hidden><span class="banner-glyph" aria-hidden="true">&#9650;</span><span class="banner-text"><span id="disk-text"></span>. Builds and installs fail with "no space left on device" when it fills up.</span> <button type="button" class="btn free-space-btn">Free Docker space</button></div>
  <div id="docker-banner" class="banner banner-failed" role="alert" hidden><span class="banner-glyph" aria-hidden="true">&#9650;</span><span class="banner-text">Docker is unreachable; showing the last known data.</span></div>
  <div id="proxy-banner" class="banner banner-busy" role="status"{{if not .Proxy.Hint}} hidden{{end}}><span class="banner-glyph" aria-hidden="true">&#9432;</span><span id="proxy-banner-text" class="banner-text">{{.Proxy.Hint}}</span><button type="button" id="proxy-banner-dismiss" class="btn btn-ghost" aria-label="Dismiss">Dismiss</button></div>
</div>

<main id="view-instances" class="view">
  <section class="section" data-section="running">
    <h2 class="section-title">Running <span class="section-count">{{len .Running}}</span></h2>
    <div class="stack-list">
      {{if .Loading}}<p class="muted" id="loading-note" role="status">loading...</p>{{end}}
      {{range .Running}}{{template "stack" .}}{{end}}
    </div>
  </section>
  <section class="section" data-section="stopped">
    <h2 class="section-title">Stopped <span class="section-count">{{len .Stopped}}</span></h2>
    <div class="stack-list">
      {{range .Stopped}}{{template "stack" .}}{{end}}
    </div>
  </section>
</main>

<main id="view-repos" class="view" hidden>
  <div id="repos-list" aria-live="polite"></div>
</main>

<main id="view-cleanup" class="view view-narrow" hidden>
  <h2>Clean up</h2>
  <p><button type="button" class="btn free-space-btn">Free Docker space</button> <span id="cleanup-disk" class="muted"></span><br>
  <span class="muted">Removes build cache, dangling images and anonymous volumes no container uses. Named volumes (your databases) are kept.</span></p>
  <p>Instances: <strong>Run</strong> first shows what would be removed in a confirmation dialog; nothing is deleted until you confirm. In a terminal, each is a dry run until you add <code>--yes</code>.</p>
  <ul id="cleanup-list"><li>loading...</li></ul>
</main>

<main id="view-settings" class="view view-narrow" hidden>
  <div id="settings-body"></div>
  <p id="settings-error" class="form-error" role="alert"></p>
</main>
</div>
</div>

<div id="activity-log"></div>

<dialog id="learn-modal" aria-labelledby="learn-title">
  <h2 id="learn-title">Learn</h2>
  <p class="muted">Opens a new terminal window in the repo with your agent already running this prompt. It learns how the project starts, checks migrations, seed and login with you, and records it as verified.</p>
  <div id="learn-agents"></div>
  <p id="learn-status" role="status"></p>
  <details>
    <summary>Prompt</summary>
    <pre id="learn-prompt"></pre>
    <button type="button" id="learn-copy" class="repo-btn">Copy prompt</button>
  </details>
  <form method="dialog"><button class="repo-btn">Close</button></form>
</dialog>

<div id="logs-panel" hidden>
  <div id="logs-header">
    <span id="logs-title"></span>
    <button id="logs-close" type="button" class="icon-btn" title="Close">&#10005;</button>
  </div>
  <pre id="logs-body"></pre>
</div>

<script src="/static/app.js"></script>
</body>
</html>

{{define "stack"}}
{{$inst := .}}
<article class="stack" data-project="{{.Project}}" data-state="{{.State}}" data-collapsed="{{if or (eq .State "running") (eq .State "partial")}}0{{else}}1{{end}}">
  <header class="stack-header" data-toggle-stack data-project="{{.Project}}">
    <span class="stack-icon stack-color-{{.ColorIndex}}">{{initial .Project}}</span>
    <div class="stack-title">
      <span class="stack-name" title="{{.Hostname}}">{{.Hostname}}</span>
      <span class="stack-path" title="{{.Root}}">{{.Root}}</span>
    </div>
    <span class="branch-tag" title="{{.Branch}}">{{.Branch}}</span>
    {{if .Legacy}}<span class="legacy-tag">legacy</span>{{end}}
    {{if .Knowledge}}<span class="knowledge knowledge-{{.Knowledge.Status}}">{{.Knowledge.Status}}</span>{{end}}
    <span class="state-badge state-{{.State}}">{{.State}}</span>
    <div class="stack-actions">
      {{if ne .State "running"}}<button class="icon-btn" data-action="up" data-project="{{.Project}}" title="Up">&#9654;</button>{{end}}
      {{if or (eq .State "running") (eq .State "partial")}}<button class="icon-btn" data-action="down" data-project="{{.Project}}" title="Down (keeps volumes)">&#9632;</button>{{end}}
      <button class="icon-btn stack-menu-toggle" data-project="{{.Project}}" title="More">&#8942;</button>
    </div>
  </header>
  {{if .Apps}}
  <div class="app-strip">
    {{range .Apps}}
    {{if .URL}}
    <a class="app-chip{{if not .Running}} stopped{{end}}" href="{{.URL}}" target="_blank" rel="noopener" title="{{.URL}}{{if .Direct}} (direct: {{.Direct}}){{end}}">{{.Label}}</a>
    {{else}}
    <span class="app-chip stopped">{{.Label}}{{if .Hint}}: {{.Hint}}{{end}}</span>
    {{end}}
    {{end}}
  </div>
  {{end}}
  <div class="stack-menu" hidden>
    {{range .Commands}}<code class="copyable cli-command" data-copy="{{.}}" title="click to copy">{{.}}</code>{{end}}
    {{if .EnvBlock}}
    <code class="copyable cli-command env-block" data-copy="{{.EnvBlock}}" data-copy-kind="env_block" data-copy-project="{{.Project}}" title="click to copy">Copy .env for host app</code>
    {{end}}
  </div>
  {{if .Warnings}}
  <ul class="warnings">
    {{range .Warnings}}<li class="warning">{{.}}</li>{{end}}
  </ul>
  {{end}}
  {{if or .OneOffRunning .OneOffLeftover}}
  <div class="oneoff-bar" data-oneoff="1">
    {{if .OneOffRunning}}<span>{{.OneOffRunning}} one-off task(s) running</span>{{end}}
    {{if .OneOffLeftover}}<span>{{.OneOffLeftover}} leftover one-off container(s){{if .OneOffCleanup}}: <code class="copyable cli-command" data-copy="{{.OneOffCleanup}}" title="click to copy">{{.OneOffCleanup}}</code>{{end}}</span>{{end}}
  </div>
  {{end}}
  {{if .SeedCommand}}
  <div class="seed-bar" data-seed="failed">The last database seed failed{{if .SeedError}}:<pre class="seed-error">{{.SeedError}}</pre>{{else}}.{{end}}
    If the app already has its data, record it as seeded (nothing runs):
    <code class="copyable cli-command" data-copy="{{.SeedDone}}" title="click to copy">{{.SeedDone}}</code>
    Otherwise retry with <code class="copyable cli-command" data-copy="{{.SeedCommand}}" title="click to copy">{{.SeedCommand}}</code>
    (or, to run it again on a populated database, <code class="copyable cli-command" data-copy="{{.SeedForce}}" title="click to copy">{{.SeedForce}}</code>)</div>
  {{end}}
  <div class="stack-body">
    {{range .Services}}
    {{$svc := .}}
    <div class="service-row" data-service="{{.Name}}">
      <div class="service-summary" data-toggle-settings data-key="{{$inst.Project}}/{{.Name}}">
        <span class="service-logo" data-kind="{{.Kind}}"></span>
        <span class="status-dot {{dotClass .}}" title="{{dotTitle .}}"></span>
        <div class="service-text">
          <span class="service-name">{{.Name}}</span>
          {{if eq .State "optional"}}<span class="service-image">not started (optional)</span>{{else}}          {{if .Image}}<span class="service-image">{{.Image}}</span>{{end}}{{end}}
        </div>
        <div class="service-endpoints">
          {{range .Endpoints}}
          {{if .Known}}
            {{if or (eq .Scheme "http") (eq .Scheme "https")}}
            <a class="endpoint-link{{if ne $svc.State "running"}} stopped{{end}}" href="{{.URL}}" target="_blank" rel="noopener" title="{{.URL}}">{{.URL}}{{if ne $svc.State "running"}} {{if or (eq $svc.State "optional") (eq $svc.State "not-started") (eq $svc.State "waiting") (eq $svc.State "waiting")}}(not started){{else}}(stopped){{end}}{{end}}{{if .Proxied}} (proxy){{end}}</a>
            {{else}}
            <span class="endpoint-copy copyable{{if ne $svc.State "running"}} stopped{{end}}" data-copy="{{.URL}}" title="click to copy">{{.URL}}{{if ne $svc.State "running"}} {{if or (eq $svc.State "optional") (eq $svc.State "not-started") (eq $svc.State "waiting") (eq $svc.State "waiting")}}(not started){{else}}(stopped){{end}}{{end}}</span>
            {{end}}
          {{else}}
            <span class="endpoint-pending">container {{.Container}} &mdash; assigned on start</span>
          {{end}}
          {{end}}
          {{if .ConnectionURL}}
          <span class="endpoint-copy copyable connection-url" data-copy="{{.ConnectionURL}}" data-copy-kind="database_url" data-copy-project="{{$inst.Project}}" data-copy-service="{{$svc.Name}}" title="click to copy the connection URL ({{.ConnectionURL}})">connection URL</span>
          {{end}}
          {{range .UseCommands}}
          <span class="endpoint-copy copyable use-command" data-copy="{{.Value}}" data-copy-kind="cli" data-copy-project="{{$inst.Project}}" data-copy-service="{{$svc.Name}}" title="click to copy: {{.Value}}">{{.Label}}</span>
          {{end}}
        </div>
        <div class="service-icons">
          {{if eq .State "running"}}
          <button class="icon-btn" data-action="service-stop" data-project="{{$inst.Project}}" data-service="{{.Name}}" title="Stop">&#9632;</button>
          {{else}}
          <button class="icon-btn" data-action="service-start" data-project="{{$inst.Project}}" data-service="{{.Name}}" title="Start">&#9654;</button>
          {{end}}
          <button class="icon-btn" data-action="restart" data-project="{{$inst.Project}}" data-service="{{.Name}}" title="Restart">&#8635;</button>
          <button class="icon-btn logs-button" data-project="{{$inst.Project}}" data-service="{{.Name}}" title="Logs">&#9776;</button>
        </div>
      </div>
      <div class="service-settings" hidden>
        {{if .Ports}}<div class="setting-row"><span class="setting-label">Ports</span><span class="setting-values">{{range .Ports}}<span class="setting-value">{{.Container}}{{if .Host}} &rarr; {{.Host}}{{end}}/{{.Protocol}}</span>{{end}}</span></div>{{end}}
        {{if .Volumes}}<div class="setting-row"><span class="setting-label">Volumes</span><span class="setting-values">{{range .Volumes}}<span class="setting-value">{{.Name}} &rarr; {{.Path}}{{if .ReadOnly}} (ro){{end}}</span>{{end}}</span></div>{{end}}
        {{if .Healthcheck}}<div class="setting-row"><span class="setting-label">Healthcheck</span><code class="setting-value">{{.Healthcheck}}</code></div>{{end}}
        {{if .DependsOn}}<div class="setting-row"><span class="setting-label">Depends on</span><span class="setting-values">{{range .DependsOn}}<span class="setting-value">{{.}}</span>{{end}}</span></div>{{end}}
        {{if .Replicas}}<div class="setting-row"><span class="setting-label">Replicas</span><span class="setting-value">{{.Replicas}}</span></div>{{end}}
        {{if .EnvKeys}}<div class="setting-row"><span class="setting-label">Environment</span><span class="setting-values">{{range .EnvKeys}}<span class="setting-value">{{.}}</span>{{end}}</span></div>{{end}}
        {{if $inst.Files}}<div class="setting-row"><span class="setting-label">Source files</span><span class="setting-values">{{range $inst.Files}}<span class="setting-value">{{.}}</span>{{end}}</span></div>{{end}}
      </div>
    </div>
    {{end}}
  </div>
</article>
{{end}}
