{
  "schema": 1,
  "status": "verified",
  "inputs": [
    { "path": "compose.yaml", "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" },
    { "path": "package.json", "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" }
  ],
  "facts": {
    "compose_files": ["compose.yaml"],
    "services": [
      {
        "name": "db",
        "image": "postgres:17-alpine",
        "db_engine": "postgres",
        "db_major_version": "17",
        "ports": ["5432"],
        "volumes": ["pgdata"],
        "networks": ["default"],
        "healthcheck": true
      },
      {
        "name": "app",
        "build": true,
        "ports": ["3000"],
        "networks": ["default"]
      }
    ],
    "package_manager": "bun",
    "lockfile": "bun.lockb",
    "runtime_versions": { "node": "20", "bun": "1.1.0" },
    "scripts": [
      { "role": "dev", "name": "dev", "source": "package.json", "command": "bun run --watch src/index.ts" },
      { "role": "migrate", "name": "db:migrate", "source": "package.json", "command": "drizzle-kit migrate" }
    ]
  },
  "refusals": [
    { "kind": "container_name", "target": "services.db", "action": "rewrite", "reason": "services.db: container_name removed so concurrent stacks don't collide" }
  ],
  "risks": [
    { "kind": "reset_on_start", "file": "package.json", "line": 7, "detail": "\"dev\" script calls \"prisma migrate reset\" on every start" }
  ],
  "env_keys": [
    { "name": "DATABASE_URL", "purpose": "database", "source": ".env.example" },
    { "name": "AUTH_SECRET", "purpose": "auth", "source": ".env.example" }
  ],
  "adapter_files": [".stackfork/compose.override.yaml"],
  "recipe": {
    "prepare": "stackfork prepare",
    "up": "stackfork up",
    "migrate": "stackfork exec app bun run db:migrate",
    "seed_once": "stackfork exec app bun run db:seed",
    "login": ["open http://app.localhost", "sign in with the seeded admin account"]
  },
  "answers": [
    { "question": "Which seed dataset should the dev stack use?", "answer": "the \"demo\" dataset; it's the only one that exists" }
  ],
  "gotchas": [
    { "problem": "migrate failed on first up: db not ready", "fix": "added a healthcheck-based depends_on so migrate waits for db" }
  ],
  "verification": {
    "date": "2026-09-23",
    "checks": ["db identity", "login"],
    "confirmation": "yep, works, I logged in and saw the demo data"
  }
}
